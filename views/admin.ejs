<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Dashboard do Admin</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background: #050811;
      color: #e2e8f0;
      font-family: Arial, Helvetica, sans-serif;
    }

    :focus-visible {
      outline: 3px solid #38bdf8;
      outline-offset: 2px;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 30;
      background: rgba(8, 14, 28, 0.96);
      border-bottom: 1px solid #1e293b;
      backdrop-filter: blur(8px);
      padding: 12px 20px;
    }

    .topbar-inner {
      max-width: 1380px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .brand {
      color: #38bdf8;
      font-size: 1.3rem;
      font-weight: 800;
      text-decoration: none;
    }

    .admin-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .admin-badge {
      font-size: 0.84rem;
      color: #94a3b8;
      margin-right: 4px;
    }

    .btn {
      background: #0284c7;
      color: #ffffff;
      border: none;
      border-radius: 7px;
      padding: 8px 13px;
      font-size: 0.84rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background-color 0.15s ease;
    }

    .btn:hover { background: #0ea5e9; }

    .btn-ghost {
      background: #0b1324;
      color: #cbd5e1;
      border: 1px solid #1e293b;
    }

    .btn-ghost:hover,
    .btn-ghost.ativo {
      background: #082f49;
      border-color: #38bdf8;
      color: #38bdf8;
    }

    .btn-danger {
      background: #7f1d1d;
      color: #fecaca;
    }

    .btn-danger:hover {
      background: #991b1b;
      color: #ffffff;
    }

    .btn-sm {
      padding: 6px 10px;
      font-size: 0.78rem;
    }

    .container {
      max-width: 1380px;
      margin: 18px auto 34px auto;
      padding: 0 20px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .nav-tabs {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .card {
      background: #0b1324;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 18px;
      box-shadow: 0 0 24px rgba(2, 132, 199, 0.1);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid #1e293b;
      flex-wrap: wrap;
    }

    .card-title {
      margin: 0;
      color: #38bdf8;
      font-size: 1.08rem;
    }

    .secao-oculta {
      display: none;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.86rem;
    }

    th, td {
      padding: 10px 11px;
      text-align: left;
      border-bottom: 1px solid #1e293b;
      vertical-align: middle;
    }

    th {
      color: #94a3b8;
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    input, select {
      background: #020617;
      color: #f8fafc;
      border: 1px solid #334155;
      border-radius: 6px;
      padding: 7px 9px;
      font-size: 0.84rem;
    }

    input:focus, select:focus {
      outline: none;
      border-color: #38bdf8;
    }

    .inline-form {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .acoes-stack {
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-width: 170px;
    }

    .estado-confirmado {
      color: #38bdf8;
      font-weight: 700;
    }

    .estado-pendente {
      color: #fbbf24;
      font-weight: 700;
    }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 14px;
    }

    .comm-box {
      background: #060b16;
      border: 1px solid #1e293b;
      border-radius: 8px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .comm-label {
      font-size: 0.78rem;
      color: #94a3b8;
    }

    .comm-channels {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .chat-box {
      background: #020617;
      border: 1px solid #1e293b;
      border-radius: 8px;
      padding: 12px;
      min-height: 150px;
      max-height: 240px;
      overflow-y: auto;
      font-size: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .msg-item {
      padding: 7px 10px;
      border-radius: 7px;
      background: #0b1324;
      border: 1px solid #1e293b;
    }

    .msg-admin {
      border-color: #0284c7;
      background: #082f49;
    }

    .status-salvo {
      font-size: 0.78rem;
      color: #38bdf8;
      min-height: 16px;
    }
  </style>
</head>
<body>
  <%
    const comprasSafe = (typeof compras !== "undefined" && Array.isArray(compras)) ? compras : [];
    const utilizadoresSafe = (typeof utilizadores !== "undefined" && Array.isArray(utilizadores)) ? utilizadores : [];
    const cfg = (typeof configAdmin !== "undefined" && configAdmin) ? configAdmin : {
      whatsapp: "",
      telegram: "",
      entidade: "21478",
      referenciaBase: "900",
      precosPlanos: { 30: 9.99, 60: 17.99, 90: 24.99, 180: 44.99, 270: 64.99, 360: 79.99 },
      metodosPagamento: []
    };
    const metodosSafe = Array.isArray(cfg.metodosPagamento) ? cfg.metodosPagamento : [];
    const adminNome = (typeof utilizador !== "undefined" && utilizador && utilizador.nome) ? utilizador.nome : "Admin";
  %>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/admin" class="brand">AlphaTV • Dashboard Admin</a>
      <div class="admin-actions">
        <span class="admin-badge">Admin: <strong><%= adminNome %></strong></span>
        <a href="/player" class="btn btn-ghost">Abrir Player</a>
        <a href="/logout" class="btn btn-danger">Sair</a>
      </div>
    </div>
  </header>

  <main class="container">
    <nav class="nav-tabs" aria-label="Secções do administrador">
      <button type="button" class="btn btn-ghost ativo" data-sec="todas" onclick="mostrarSecao('todas', this)">Todas as Secções</button>
      <button type="button" class="btn btn-ghost" data-sec="pagamentos" onclick="mostrarSecao('pagamentos', this)">Pagamentos</button>
      <button type="button" class="btn btn-ghost" data-sec="planos" onclick="mostrarSecao('planos', this)">Planos & Métodos</button>
      <button type="button" class="btn btn-ghost" data-sec="comunicacao" onclick="mostrarSecao('comunicacao', this)">WhatsApp / Telegram / Chat</button>
      <button type="button" class="btn btn-ghost" data-sec="utilizadores" onclick="mostrarSecao('utilizadores', this)">Utilizadores</button>
    </nav>

    <!-- 1. PAGAMENTOS E CONFIRMAÇÃO DE RECEBIMENTO -->
    <section id="sec-pagamentos" class="card">
      <div class="card-header">
        <h2 class="card-title">Pagamentos e Confirmação de Recebimento</h2>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Recibo</th>
              <th>Utilizador</th>
              <th>Plano</th>
              <th>Método / Entidade / Ref</th>
              <th>Valor</th>
              <th>Estado</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody>
            <% if (comprasSafe.length === 0) { %>
              <tr>
                <td colspan="7" style="color:#94a3b8;">Nenhum pedido de pagamento registado.</td>
              </tr>
            <% } else { %>
              <% comprasSafe.forEach(function(compra) {
                const confirmadoAdmin = String(compra.status || "").toLowerCase() === "confirmado" && compra.confirmadoPorAdmin === true;
              %>
                <tr>
                  <td><strong><%= compra.codigoRecibo || "-" %></strong></td>
                  <td>
                    <%= compra.nomeUtilizador || "Utilizador" %>
                    <% if (compra.emailUtilizador) { %>
                      <div style="font-size:0.78rem; color:#94a3b8;">(<%= compra.emailUtilizador %>)</div>
                    <% } %>
                  </td>
                  <td><%= compra.nomePlano || (compra.planoDias ? compra.planoDias + " dias" : "-") %></td>
                  <td>
                    <div><%= compra.metodoPagamento || "-" %></div>
                    <div style="font-size:0.78rem; color:#94a3b8;">
                      Ent: <%= compra.entidadePagamento || cfg.entidade || "21478" %> • Ref: <%= compra.referenciaPagamento || "-" %>
                    </div>
                  </td>
                  <td>
                    <div><%= Number(compra.valorFinal ?? compra.valorBase ?? 0).toFixed(2) %> EUR</div>
                    <% if (compra.moedaConvertida && compra.moedaConvertida !== "EUR") { %>
                      <div style="font-size:0.76rem; color:#38bdf8;">
                        ≈ <%= Number(compra.valorConvertido || 0).toFixed(2) %> <%= compra.moedaConvertida %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <% if (confirmadoAdmin) { %>
                      <span class="estado-confirmado">Confirmado</span>
                    <% } else { %>
                      <span class="estado-pendente">Pendente</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="acoes-stack">
                      <% if (!confirmadoAdmin && compra.codigoRecibo) { %>
                        <form action="/admin/confirmar-pagamento/<%= encodeURIComponent(compra.codigoRecibo) %>" method="POST" style="margin:0;">
                          <button type="submit" class="btn btn-sm" style="width:100%; justify-content:center;">
                            Confirmar Recebimento
                          </button>
                        </form>
                        <form action="/pagamento/<%= encodeURIComponent(compra.codigoRecibo) %>/apagar" method="POST" onsubmit="return confirm('Apagar este pagamento pendente?');" style="margin:0;">
                          <button type="submit" class="btn btn-danger btn-sm" style="width:100%; justify-content:center;">
                            Apagar
                          </button>
                        </form>
                      <% } %>
                      <% if (confirmadoAdmin && compra.codigoRecibo) { %>
                        <a href="/recibo/<%= encodeURIComponent(compra.codigoRecibo) %>" class="btn btn-ghost btn-sm" style="justify-content:center;">
                          Ver Recibo
                        </a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 2. PREÇOS DOS PLANOS (30, 60, 90, 180, 270, 360 DIAS) & MÉTODOS DE PAGAMENTO -->
    <section id="sec-planos" class="card">
      <div class="card-header">
        <h2 class="card-title">Planos (30, 60, 90, 180, 270, 360 Dias) • Entidade & Métodos de Pagamento</h2>
      </div>

      <form action="/admin/precos-planos" method="POST" class="grid-3" style="margin-bottom:18px;">
        <div class="comm-box">
          <strong style="color:#38bdf8; font-size:0.9rem;">Preços dos Planos (EUR)</strong>
          <% [30, 60, 90, 180, 270, 360].forEach(function(dias) { %>
            <label class="comm-label">
              Plano <%= dias %> Dias:
              <input type="number" step="0.01" min="0.5" name="plano_<%= dias %>" value="<%= cfg.precosPlanos[dias] ?? 9.99 %>" style="width:100%; margin-top:4px;" />
            </label>
          <% }); %>
        </div>

        <div class="comm-box">
          <strong style="color:#38bdf8; font-size:0.9rem;">Entidade Geral & Série de Referência</strong>
          <label class="comm-label">
            Entidade Padrão:
            <input type="text" name="entidade" value="<%= cfg.entidade || '21478' %>" style="width:100%; margin-top:4px;" />
          </label>
          <label class="comm-label">
            Prefixo de Referência Automática:
            <input type="text" name="referenciaBase" value="<%= cfg.referenciaBase || '900' %>" style="width:100%; margin-top:4px;" />
          </label>
          <div style="margin-top:auto;">
            <button type="submit" class="btn btn-sm">Guardar Preços e Entidade</button>
          </div>
        </div>
      </form>

      <!-- CADASTRO E EDIÇÃO DOS MÉTODOS DE PAGAMENTO -->
      <div class="comm-box">
        <strong style="color:#38bdf8; font-size:0.95rem;">Métodos de Pagamento (Gerar / Cadastrar / Editar Entidade e Conta)</strong>

        <form action="/admin/metodos-pagamento" method="POST">
          <input type="hidden" name="acao" value="salvar" />
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Ativo</th>
                  <th>Método</th>
                  <th>Entidade</th>
                  <th>Conta / IBAN / Chave</th>
                  <th>Descrição</th>
                  <th>Remover</th>
                </tr>
              </thead>
              <tbody>
                <% metodosSafe.forEach(function(m) { %>
                  <tr>
                    <td>
                      <input type="checkbox" name="ativo_<%= m.id %>" <%= m.ativo !== false ? "checked" : "" %> />
                    </td>
                    <td>
                      <input type="text" name="nome_<%= m.id %>" value="<%= m.nome %>" style="width:160px;" />
                    </td>
                    <td>
                      <input type="text" name="entidade_<%= m.id %>" value="<%= m.entidade || cfg.entidade || '21478' %>" style="width:110px;" />
                    </td>
                    <td>
                      <input type="text" name="conta_<%= m.id %>" value="<%= m.contaDestino || '' %>" placeholder="IBAN / Tel / Email" style="width:190px;" />
                    </td>
                    <td>
                      <input type="text" name="detalhe_<%= m.id %>" value="<%= m.detalhe || '' %>" style="width:200px;" />
                    </td>
                    <td>
                      <button type="submit" name="acao" value="remover_<%= m.id %>" class="btn btn-danger btn-sm">Apagar</button>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <div style="margin-top:10px;">
            <button type="submit" class="btn btn-sm">Guardar Alterações nos Métodos</button>
          </div>
        </form>

        <form action="/admin/metodos-pagamento" method="POST" class="inline-form" style="margin-top:12px; padding-top:12px; border-top:1px solid #1e293b;">
          <input type="hidden" name="acao" value="novo" />
          <input type="text" name="novoNome" placeholder="Novo método (ex: Revolut / Stripe)" required />
          <input type="text" name="novaEntidade" value="<%= cfg.entidade || '21478' %>" placeholder="Entidade" style="width:110px;" />
          <input type="text" name="novaConta" placeholder="Conta / IBAN / Chave" />
          <input type="text" name="novoDetalhe" placeholder="Instrução curta" />
          <button type="submit" class="btn btn-sm">+ Cadastrar Método</button>
        </form>
      </div>
    </section>

    <!-- 3. COMUNICAÇÃO COM CLIENTE + CONTACTO DO ADMIN -->
    <section id="sec-comunicacao" class="card">
      <div class="card-header">
        <h2 class="card-title">Comunicação com o Cliente • WhatsApp, Telegram e Chat Direto</h2>
      </div>

      <div class="grid-3">
        <div class="comm-box">
          <strong style="color:#38bdf8; font-size:0.92rem;">Meu Número / Contacto do Admin</strong>
          <input id="adminWhatsappNumero" type="text" value="<%= cfg.whatsapp || '' %>" placeholder="Seu número WhatsApp (ex: +351912345678)" />
          <input id="adminTelegramContacto" type="text" value="<%= cfg.telegram || '' %>" placeholder="Seu Telegram (ex: @admin ou https://t.me/admin)" />
          <div class="comm-channels">
            <button type="button" class="btn btn-sm" onclick="salvarContatoAdmin()">Salvar Meu Contacto</button>
          </div>
          <div id="statusContatoAdmin" class="status-salvo"></div>
        </div>

        <div class="comm-box">
          <strong style="color:#38bdf8; font-size:0.92rem;">Interagir com Cliente (WhatsApp / Telegram)</strong>
          <select id="commClienteSelect" onchange="sincronizarClienteComm()">
            <option value="">-- Escolher cliente da lista --</option>
            <% utilizadoresSafe.forEach(function(u) { %>
              <option
                value="<%= u._id %>"
                data-nome="<%= u.nome || '' %>"
                data-email="<%= u.email || '' %>"
                data-telefone="<%= u.telefone || '' %>"
              >
                <%= u.nome || u.email %> (<%= u.telefone || "sem telefone" %>)
              </option>
            <% }); %>
          </select>

          <input id="commTelefoneCliente" type="text" placeholder="Telefone do cliente WhatsApp (ex: +351912345678)" />
          <input id="commTelegramCliente" type="text" placeholder="Utilizador/link Telegram (ex: @cliente ou https://t.me/...)" />
          <input id="commMensagemRapida" type="text" placeholder="Mensagem (ex: Olá, o seu recebimento foi confirmado no AlphaTV!)" />

          <div class="comm-channels">
            <button type="button" class="btn btn-sm" onclick="abrirWhatsApp()">WhatsApp</button>
            <button type="button" class="btn btn-ghost btn-sm" onclick="abrirTelegram()">Telegram</button>
          </div>
        </div>

        <div class="comm-box">
          <strong style="color:#38bdf8; font-size:0.92rem;">Chat Direto em Tempo Real</strong>
          <div id="chatClienteLog" class="chat-box">
            <div class="msg-item">
              <strong style="color:#38bdf8;">Sistema:</strong> A aguardar mensagens do suporte técnico...
            </div>
          </div>
          <form class="inline-form" onsubmit="enviarChatAdmin(event)" style="width:100%;">
            <input id="chatAdminInput" type="text" placeholder="Responder ao cliente em tempo real..." style="flex:1;" required />
            <button type="submit" class="btn btn-sm">Enviar</button>
          </form>
        </div>
      </div>
    </section>

    <!-- 4. UTILIZADORES -->
    <section id="sec-utilizadores" class="card">
      <div class="card-header">
        <h2 class="card-title">Utilizadores, País/Telefone, Dias Gratuitos e Código Promocional</h2>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>País / Telefone</th>
              <th>Perfil</th>
              <th>Acesso / Dias</th>
              <th>Código Convite</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (utilizadoresSafe.length === 0) { %>
              <tr>
                <td colspan="7" style="color:#94a3b8;">Nenhum utilizador encontrado.</td>
              </tr>
            <% } else { %>
              <% utilizadoresSafe.forEach(function(u) {
                const paisAtual = u.pais || "PT";
                const roleAtual = String(u.role || "Utilizador");
              %>
                <tr>
                  <td><strong><%= u.nome || "-" %></strong></td>
                  <td><%= u.email || "-" %></td>
                  <td>
                    <form action="/admin/utilizador/<%= u._id %>/contacto" method="POST" class="inline-form">
                      <select name="pais">
                        <option value="PT" <%= paisAtual === "PT" ? "selected" : "" %>>Portugal (+351)</option>
                        <option value="BR" <%= paisAtual === "BR" ? "selected" : "" %>>Brasil (+55)</option>
                        <option value="OUTROS" <%= paisAtual === "OUTROS" ? "selected" : "" %>>Internacional</option>
                      </select>
                      <input type="text" name="telefone" value="<%= u.telefone || '' %>" style="width:135px;" />
                      <button type="submit" class="btn btn-ghost btn-sm">Salvar</button>
                    </form>
                  </td>
                  <td><%= roleAtual %></td>
                  <td>
                    <span class="estado-pendente"><%= u.statusSubscricao || "trial" %></span>
                    <% if (u.pagoAte) { %>
                      <div style="font-size:0.78rem; color:#94a3b8;">Até <%= new Date(u.pagoAte).toLocaleDateString("pt-PT") %></div>
                    <% } %>
                  </td>
                  <td>
                    <% if (u.codigoPromocionalLiberado && u.codigoPromocional) { %>
                      <strong style="color:#38bdf8;"><%= u.codigoPromocional %></strong>
                    <% } else { %>
                      <span style="color:#94a3b8;">Não disponibilizado</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="acoes-stack">
                      <form action="/admin/utilizador/<%= u._id %>/dias" method="POST" class="inline-form">
                        <input type="number" name="dias" value="30" min="1" max="3650" style="width:62px;" />
                        <button type="submit" class="btn btn-sm">Renovar Dias</button>
                      </form>

                      <form action="/admin/utilizador/<%= u._id %>/codigo-promocional" method="POST" style="margin:0;">
                        <button type="submit" class="btn btn-ghost btn-sm" style="width:100%; justify-content:center;">Disponibilizar Código</button>
                      </form>

                      <% if (roleAtual.toLowerCase() !== "administrador") { %>
                        <form action="/admin/utilizador/<%= u._id %>/tornar-admin" method="POST" style="margin:0;">
                          <button type="submit" class="btn btn-ghost btn-sm" style="width:100%; justify-content:center;">Tornar Admin</button>
                        </form>
                      <% } %>

                      <form action="/admin/utilizador/<%= u._id %>/apagar" method="POST" onsubmit="return confirm('Apagar este utilizador?');" style="margin:0;">
                        <button type="submit" class="btn btn-danger btn-sm" style="width:100%; justify-content:center;">Apagar</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    const INATIVIDADE_MS = 30 * 60 * 1000;
    let timerInatividade = null;

    function resetarInatividadeAdmin() {
      if (timerInatividade) clearTimeout(timerInatividade);
      timerInatividade = setTimeout(function () {
        window.location.href = "/logout";
      }, INATIVIDADE_MS);
    }

    ["click", "keydown", "mousemove", "scroll", "touchstart"].forEach(function (evt) {
      window.addEventListener(evt, resetarInatividadeAdmin, { passive: true });
    });

    function escaparHtml(str) {
      return String(str || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function mostrarSecao(secao, btnClicado) {
      const pag = document.getElementById("sec-pagamentos");
      const planos = document.getElementById("sec-planos");
      const comm = document.getElementById("sec-comunicacao");
      const users = document.getElementById("sec-utilizadores");

      if (pag) pag.classList.toggle("secao-oculta", !(secao === "todas" || secao === "pagamentos"));
      if (planos) planos.classList.toggle("secao-oculta", !(secao === "todas" || secao === "planos"));
      if (comm) comm.classList.toggle("secao-oculta", !(secao === "todas" || secao === "comunicacao"));
      if (users) users.classList.toggle("secao-oculta", !(secao === "todas" || secao === "utilizadores"));

      document.querySelectorAll(".nav-tabs .btn-ghost").forEach((b) => b.classList.remove("ativo"));
      if (btnClicado) btnClicado.classList.add("ativo");
    }

    async function salvarContatoAdmin() {
      const whatsapp = (document.getElementById("adminWhatsappNumero")?.value || "").trim();
      const telegram = (document.getElementById("adminTelegramContacto")?.value || "").trim();
      const statusEl = document.getElementById("statusContatoAdmin");

      try {
        await fetch("/api/admin/contato-suporte", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ whatsapp, telegram }),
        });
      } catch (e) {}

      if (statusEl) statusEl.textContent = "Contacto do admin guardado com sucesso.";
    }

    function sincronizarClienteComm() {
      const sel = document.getElementById("commClienteSelect");
      if (!sel) return;
      const opt = sel.options[sel.selectedIndex];
      const telInput = document.getElementById("commTelefoneCliente");
      if (opt && telInput && opt.dataset.telefone) {
        telInput.value = opt.dataset.telefone;
      }
      sincronizarMensagensTempoReal();
    }

    function abrirWhatsApp() {
      const telCliente = (document.getElementById("commTelefoneCliente")?.value || "").replace(/\D/g, "");
      const telAdmin = (document.getElementById("adminWhatsappNumero")?.value || "").replace(/\D/g, "");
      const alvo = telCliente || telAdmin;
      const msg = (document.getElementById("commMensagemRapida")?.value || "Olá, suporte AlphaTV.").trim();

      if (!alvo) {
        alert("Preencha o seu número do Admin ou selecione um número de cliente.");
        return;
      }
      window.open("https://wa.me/" + alvo + "?text=" + encodeURIComponent(msg), "_blank", "noopener");
    }

    function abrirTelegram() {
      const tgCliente = (document.getElementById("commTelegramCliente")?.value || "").trim();
      const tgAdmin = (document.getElementById("adminTelegramContacto")?.value || "").trim();
      const alvo = tgCliente || tgAdmin;
      const msg = (document.getElementById("commMensagemRapida")?.value || "Olá, suporte AlphaTV.").trim();

      if (alvo.startsWith("http://") || alvo.startsWith("https://")) {
        window.open(alvo, "_blank", "noopener");
        return;
      }

      const username = alvo.replace(/^@/, "");
      const url = username
        ? "https://t.me/" + encodeURIComponent(username)
        : "https://t.me/share/url?url=" + encodeURIComponent("https://alphatv-wg41.onrender.com") + "&text=" + encodeURIComponent(msg);
      window.open(url, "_blank", "noopener");
    }

    async function sincronizarMensagensTempoReal() {
      const log = document.getElementById("chatClienteLog");
      const sel = document.getElementById("commClienteSelect");
      if (!log) return;

      const emailFiltro = sel && sel.selectedIndex > 0 ? (sel.options[sel.selectedIndex].dataset.email || "") : "";
      const qs = emailFiltro ? "?clienteEmail=" + encodeURIComponent(emailFiltro) : "";

      try {
        const resp = await fetch("/api/suporte/mensagens" + qs);
        if (!resp.ok) return;
        const data = await resp.json();
        const lista = Array.isArray(data.mensagens) ? data.mensagens : [];

        if (lista.length === 0) {
          log.innerHTML = '<div class="msg-item"><strong style="color:#38bdf8;">Chat:</strong> Nenhuma mensagem recebida ainda.</div>';
          return;
        }

        log.innerHTML = lista.map((m) => {
          const isAdminMsg = m.remetente === "admin";
          const prefixo = isAdminMsg
            ? "Admin → " + escaparHtml(m.clienteNome || m.clienteEmail || "Cliente")
            : escaparHtml(m.autorNome || "Cliente") + " (" + escaparHtml(m.clienteEmail || "") + ")";
          return '<div class="msg-item ' + (isAdminMsg ? "msg-admin" : "") + '">' +
            '<strong>' + prefixo + ':</strong> ' + escaparHtml(m.texto) +
            '</div>';
        }).join("");
        log.scrollTop = log.scrollHeight;
      } catch (e) {}
    }

    async function enviarChatAdmin(event) {
      event.preventDefault();
      const input = document.getElementById("chatAdminInput");
      const sel = document.getElementById("commClienteSelect");
      if (!input) return;

      const texto = input.value.trim();
      if (!texto) return;

      const opt = sel && sel.selectedIndex > 0 ? sel.options[sel.selectedIndex] : null;
      const clienteEmail = opt ? (opt.dataset.email || "geral@alphatv") : "geral@alphatv";
      const clienteNome = opt ? (opt.dataset.nome || opt.textContent.trim()) : "Cliente";

      try {
        await fetch("/api/suporte/mensagens", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ texto, clienteEmail, clienteNome }),
        });
        input.value = "";
        await sincronizarMensagensTempoReal();
      } catch (e) {}
    }

    window.addEventListener("DOMContentLoaded", function () {
      resetarInatividadeAdmin();
      sincronizarMensagensTempoReal();
      setInterval(sincronizarMensagensTempoReal, 2000);
    });
  </script>
</body>
</html>