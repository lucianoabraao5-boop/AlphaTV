<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Dashboard do Administrador</title>
  <style>
    body {
      background-color: #050811;
      color: #e2e8f0;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      background: #0b1324;
      border-bottom: 1px solid #1e293b;
      padding: 14px 24px;
    }
    .marca {
      color: #38bdf8;
      font-size: 1.25rem;
      font-weight: bold;
    }
    .acoes-topo {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .btn, a.btn {
      background: #0284c7;
      color: #ffffff;
      text-decoration: none;
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 0.88rem;
      cursor: pointer;
    }
    .btn:hover, a.btn:hover {
      background: #0ea5e9;
    }
    .btn-renovar {
      background: #0369a1;
      border: 1px solid #38bdf8;
    }
    .btn-renovar:hover {
      background: #0284c7;
    }
    .btn-sair {
      background: #7f1d1d;
    }
    .btn-sair:hover {
      background: #991b1b;
    }
    .btn-secundario {
      background: #1e293b;
      border: 1px solid #334155;
    }
    .btn-secundario:hover {
      background: #334155;
    }
    .input-dias {
      width: 64px;
      padding: 7px 8px;
      border-radius: 6px;
      border: 1px solid #334155;
      background: #020617;
      color: #f8fafc;
      font-size: 0.88rem;
    }
    main {
      max-width: 1180px;
      margin: 28px auto;
      padding: 0 20px;
    }
    .titulo-pagina {
      margin: 0 0 6px 0;
      color: #38bdf8;
      font-size: 1.5rem;
    }
    .subtitulo {
      margin: 0 0 22px 0;
      color: #94a3b8;
      font-size: 0.95rem;
    }
    .grid-kpis {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 16px;
      margin-bottom: 22px;
    }
    .kpi-card {
      background: #0b1324;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 18px;
      box-shadow: 0 0 20px rgba(0, 180, 255, 0.08);
    }
    .kpi-label {
      color: #94a3b8;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .kpi-valor {
      color: #38bdf8;
      font-size: 1.8rem;
      font-weight: bold;
      margin-top: 6px;
    }
    .card {
      background: #0b1324;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 22px;
      box-shadow: 0 0 24px rgba(0, 180, 255, 0.1);
    }
    .cabecalho-lista {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 18px;
    }
    .cabecalho-lista h2 {
      margin: 0;
      color: #38bdf8;
    }
    .filtro-input {
      padding: 9px 12px;
      border-radius: 6px;
      border: 1px solid #334155;
      background: #020617;
      color: #f8fafc;
      min-width: 240px;
    }
    .tabela-wrap {
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      text-align: left;
      padding: 12px 14px;
      border-bottom: 1px solid #1e293b;
    }
    th {
      color: #94a3b8;
      font-size: 0.84rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    tr:hover {
      background: rgba(30, 41, 59, 0.45);
    }
    .badge-admin {
      background: #082f49;
      color: #38bdf8;
      border: 1px solid #0284c7;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.8rem;
    }
    .badge-user {
      background: #1e293b;
      color: #cbd5e1;
      border: 1px solid #475569;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.8rem;
    }
    .acoes-linha {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }
    .acoes-linha form {
      margin: 0;
      display: flex;
      align-items: center;
      gap: 6px;
    }
  </style>
</head>
<body>
  <%
    const listaUsers = Array.isArray(utilizadores) ? utilizadores : [];
    const totalAdmins = listaUsers.filter(u => (u.role || "").toLowerCase() === "administrador").length;
    const totalUsers = listaUsers.filter(u => (u.role || "").toLowerCase() !== "administrador").length;
  %>

  <header>
    <div class="marca">AlphaTV • Dashboard Admin</div>
    <div class="acoes-topo">
      <span>Admin: <strong><%= utilizador ? utilizador.nome : "Administrador" %></strong></span>
      <a href="/player" class="btn btn-secundario">Abrir Player</a>
      <a href="/logout" class="btn btn-sair">Sair</a>
    </div>
  </header>

  <main>
    <h1 class="titulo-pagina">Gestão Central da Plataforma</h1>
    <p class="subtitulo">Controlo de contas, perfis de acesso, renovação de dias gratuitos e subscrições do AlphaTV.</p>

    <div class="grid-kpis">
      <div class="kpi-card">
        <div class="kpi-label">Total de Contas</div>
        <div class="kpi-valor"><%= listaUsers.length %></div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Administradores</div>
        <div class="kpi-valor"><%= totalAdmins %></div>
      </div>
      <div class="kpi-card">
        <div class="kpi-label">Utilizadores Comuns</div>
        <div class="kpi-valor"><%= totalUsers %></div>
      </div>
    </div>

    <div class="card">
      <div class="cabecalho-lista">
        <h2>Todos os Utilizadores</h2>
        <input
          type="text"
          id="pesquisaUser"
          class="filtro-input"
          placeholder="Pesquisar por nome, e-mail ou perfil..."
          onkeyup="filtrarTabela()"
        />
      </div>

      <div class="tabela-wrap">
        <table id="tabelaUtilizadores">
          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Perfil</th>
              <th>Subscrição / Dias Gratuitos</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (listaUsers.length === 0) { %>
              <tr>
                <td colspan="5" style="color: #94a3b8; text-align: center;">
                  Nenhum utilizador registado.
                </td>
              </tr>
            <% } %>

            <% listaUsers.forEach(function(u) { %>
              <% const isAdminRow = (u.role || "").toLowerCase() === "administrador"; %>
              <tr>
                <td><strong><%= u.nome %></strong></td>
                <td><%= u.email || "Sem e-mail" %></td>
                <td>
                  <% if (isAdminRow) { %>
                    <span class="badge-admin">Administrador</span>
                  <% } else { %>
                    <span class="badge-user">Utilizador</span>
                  <% } %>
                </td>
                <td>
                  <%
                    const agoraAdmin = new Date();
                    const pagoAtivoRow = u.statusSubscricao === "ativo" && u.pagoAte && new Date(u.pagoAte) > agoraAdmin;
                    const trialDateRow = u.trialEndsAt ? new Date(u.trialEndsAt) : null;
                    const diasRestantesRow = trialDateRow
                      ? Math.max(0, Math.ceil((trialDateRow - agoraAdmin) / (24 * 60 * 60 * 1000)))
                      : 7;
                  %>
                  <% if (isAdminRow) { %>
                    <span class="badge-admin">Acesso Admin</span>
                  <% } else if (pagoAtivoRow) { %>
                    <span class="badge-admin">Ativo (até <%= new Date(u.pagoAte).toLocaleDateString("pt-PT") %>)</span>
                  <% } else if (trialDateRow && trialDateRow > agoraAdmin) { %>
                    <span class="badge-user">Teste: <%= diasRestantesRow %> dia(s)</span>
                  <% } else { %>
                    <span class="badge-user">Expirado (Cobrança)</span>
                  <% } %>
                </td>
                <td>
                  <div class="acoes-linha">
                    <% if (!isAdminRow) { %>
                      <form action="/admin/utilizadores/<%= u._id %>/renovar-teste" method="POST">
                        <input
                          type="number"
                          name="dias"
                          value="7"
                          min="1"
                          max="365"
                          class="input-dias"
                          title="Número de dias de gratuidade a adicionar"
                        />
                        <button type="submit" class="btn btn-renovar">Renovar Dias</button>
                      </form>
                    <% } %>

                    <form action="/admin/utilizadores/<%= u._id %>/role" method="POST">
                      <button type="submit" class="btn btn-secundario">
                        <%= isAdminRow ? "Tornar Utilizador" : "Tornar Admin" %>
                      </button>
                    </form>

                    <% if (utilizador && String(u._id) !== String(utilizador.id)) { %>
                      <form
                        action="/admin/utilizadores/<%= u._id %>/apagar"
                        method="POST"
                        onsubmit="return confirm('Apagar este utilizador?');"
                      >
                        <button type="submit" class="btn btn-sair">Apagar</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script>
    function filtrarTabela() {
      const termo = document.getElementById("pesquisaUser").value.toLowerCase();
      const linhas = document.querySelectorAll("#tabelaUtilizadores tbody tr");
      linhas.forEach(linha => {
        const texto = linha.textContent.toLowerCase();
        linha.style.display = texto.includes(termo) ? "" : "none";
      });
    }
  </script>
</body>
</html>