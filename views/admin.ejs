<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Painel de Administração</title>
  <style>
    body {
      background-color: #070b14;
      color: #e2e8f0;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      background: #0f172a;
      border-bottom: 1px solid #1e293b;
      padding: 14px 24px;
    }
    .marca {
      color: #38bdf8;
      font-size: 1.25rem;
      font-weight: bold;
    }
    .acoes-topo {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .btn, a.btn {
      background: #0284c7;
      color: #ffffff;
      text-decoration: none;
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 0.88rem;
      cursor: pointer;
    }
    .btn:hover, a.btn:hover {
      background: #0ea5e9;
    }
    .btn-sair {
      background: #7f1d1d;
    }
    .btn-sair:hover {
      background: #991b1b;
    }
    .btn-secundario {
      background: #1e293b;
      border: 1px solid #334155;
    }
    .btn-secundario:hover {
      background: #334155;
    }
    main {
      max-width: 1100px;
      margin: 28px auto;
      padding: 0 20px;
    }
    .card {
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 22px;
      box-shadow: 0 0 24px rgba(0, 180, 255, 0.1);
    }
    .cabecalho-lista {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 18px;
    }
    .cabecalho-lista h2 {
      margin: 0;
      color: #38bdf8;
    }
    .filtro-input {
      padding: 9px 12px;
      border-radius: 6px;
      border: 1px solid #334155;
      background: #020617;
      color: #f8fafc;
      min-width: 240px;
    }
    .tabela-wrap {
      overflow-x: auto;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      text-align: left;
      padding: 12px 14px;
      border-bottom: 1px solid #1e293b;
    }
    th {
      color: #94a3b8;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    tr:hover {
      background: rgba(30, 41, 59, 0.45);
    }
    .badge-admin {
      background: #082f49;
      color: #38bdf8;
      border: 1px solid #0284c7;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.8rem;
    }
    .badge-user {
      background: #1e293b;
      color: #cbd5e1;
      border: 1px solid #475569;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.8rem;
    }
    .acoes-linha {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .acoes-linha form {
      margin: 0;
    }
  </style>
</head>
<body>
  <header>
    <div class="marca">AlphaTV • Administração</div>
    <div class="acoes-topo">
      <span>Admin: <strong><%= utilizador.nome %></strong></span>
      <a href="/player" class="btn">Ir para o Player</a>
      <a href="/logout" class="btn btn-sair">Sair</a>
    </div>
  </header>

  <main>
    <div class="card">
      <div class="cabecalho-lista">
        <h2>Utilizadores Registados (<%= utilizadores.length %>)</h2>
        <input
          type="text"
          id="pesquisaUser"
          class="filtro-input"
          placeholder="Filtrar por nome ou e-mail..."
          onkeyup="filtrarTabela()"
        />
      </div>

      <div class="tabela-wrap">
        <table id="tabelaUtilizadores">
          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>Perfil</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (utilizadores.length === 0) { %>
              <tr>
                <td colspan="4" style="color: #94a3b8; text-align: center;">
                  Nenhum utilizador encontrado na base de dados.
                </td>
              </tr>
            <% } %>

            <% utilizadores.forEach(u => { %>
              <tr>
                <td><strong><%= u.nome %></strong></td>
                <td><%= u.email || "Sem e-mail" %></td>
                <td>
                  <% if (u.role === "Administrador") { %>
                    <span class="badge-admin">Administrador</span>
                  <% } else { %>
                    <span class="badge-user">Utilizador</span>
                  <% } %>
                </td>
                <td>
                  <div class="acoes-linha">
                    <form action="/admin/utilizadores/<%= u._id %>/role" method="POST">
                      <button type="submit" class="btn btn-secundario">
                        <%= u.role === "Administrador" ? "Tornar Utilizador" : "Tornar Admin" %>
                      </button>
                    </form>

                    <% if (String(u._id) !== String(utilizador.id)) { %>
                      <form
                        action="/admin/utilizadores/<%= u._id %>/apagar"
                        method="POST"
                        onsubmit="return confirm('Tens a certeza que queres apagar este utilizador?');"
                      >
                        <button type="submit" class="btn btn-sair">Apagar</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script>
    function filtrarTabela() {
      const termo = document.getElementById("pesquisaUser").value.toLowerCase();
      const linhas = document.querySelectorAll("#tabelaUtilizadores tbody tr");
      linhas.forEach(linha => {
        const texto = linha.textContent.toLowerCase();
        linha.style.display = texto.includes(termo) ? "" : "none";
      });
    }
  </script>
</body>
</html>