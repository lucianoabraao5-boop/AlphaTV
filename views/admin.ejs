<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Dashboard do Administrador</title>
  <style>
    body { background: #050811; color: #e2e8f0; font-family: Arial, sans-serif; margin: 0; }
    header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; background: #0b1324; border-bottom: 1px solid #1e293b; padding: 14px 24px; }
    .marca { color: #38bdf8; font-size: 1.25rem; font-weight: bold; }
    .btn, a.btn { background: #0284c7; color: #fff; text-decoration: none; border: none; padding: 8px 12px; border-radius: 6px; font-size: 0.84rem; cursor: pointer; font-weight: bold; }
    .btn:hover, a.btn:hover { background: #0ea5e9; }
    .btn-sair { background: #7f1d1d; }
    .btn-secundario { background: #1e293b; border: 1px solid #334155; }
    .input-dias { width: 58px; padding: 6px 8px; border-radius: 6px; border: 1px solid #334155; background: #020617; color: #fff; }
    .input-tel, .select-pais { padding: 6px 8px; border-radius: 6px; border: 1px solid #334155; background: #020617; color: #fff; font-size: 0.82rem; }
    .input-tel { width: 135px; }
    main { max-width: 1280px; margin: 24px auto; padding: 0 20px; display: grid; gap: 20px; }
    .card { background: #0b1324; border: 1px solid #1e293b; border-radius: 10px; padding: 20px; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #1e293b; font-size: 0.86rem; vertical-align: middle; }
    th { color: #94a3b8; }
    .acoes { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .acoes form, .form-contacto { margin: 0; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  </style>
</head>
<body>
  <% const listaUsers = Array.isArray(utilizadores) ? utilizadores : []; %>
  <% const listaCompras = Array.isArray(compras) ? compras : []; %>

  <header>
    <div class="marca">AlphaTV • Dashboard Admin</div>
    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <span>Admin: <strong><%= utilizador.nome %></strong></span>
      <a href="/player" class="btn btn-secundario">Abrir Player</a>
      <a href="/logout" class="btn btn-sair">Sair</a>
    </div>
  </header>

  <main>
    <div class="card">
      <h2 style="margin-top:0; color:#38bdf8;">Pagamentos e Confirmação de Acesso</h2>
      <div style="overflow-x:auto;">
        <table>
          <thead>
            <tr>
              <th>Recibo</th>
              <th>Utilizador</th>
              <th>Plano</th>
              <th>Método</th>
              <th>Valor</th>
              <th>Estado</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody>
            <% if (listaCompras.length === 0) { %>
              <tr><td colspan="7" style="color:#94a3b8;">Sem pedidos de pagamento registados.</td></tr>
            <% } %>
            <% listaCompras.forEach(function(cp) { %>
              <tr>
                <td><strong><%= cp.codigoRecibo %></strong></td>
                <td><%= cp.nomeUtilizador %> (<%= cp.emailUtilizador %>)</td>
                <td><%= cp.nomePlano %></td>
                <td><%= cp.metodoPagamento %></td>
                <td><%= Number(cp.valorFinal).toFixed(2) %> <%= cp.moeda || "EUR" %></td>
                <td><%= cp.status === "confirmado" ? "Confirmado" : "Pendente" %></td>
                <td>
                  <% if (cp.status !== "confirmado") { %>
                    <form action="/admin/compras/<%= encodeURIComponent(cp.codigoRecibo) %>/confirmar" method="POST" style="margin:0;">
                      <button type="submit" class="btn">Confirmar e Liberar Acesso</button>
                    </form>
                  <% } else { %>
                    <a href="/recibo/<%= encodeURIComponent(cp.codigoRecibo) %>" class="btn btn-secundario">Ver Recibo</a>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <h2 style="margin-top:0; color:#38bdf8;">Utilizadores, País/Telefone, Dias Gratuitos e Código Promocional</h2>
      <div style="overflow-x:auto;">
        <table>
          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>País / Telefone</th>
              <th>Perfil</th>
              <th>Acesso / Dias</th>
              <th>Código Convite</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% listaUsers.forEach(function(u) { %>
              <%
                const isAdminRow = String(u.role || "").toLowerCase() === "administrador";
                const eAdmConta = isAdminRow || String(u.email || "").toLowerCase() === "adm@adm.pt" || String(u.nome || "").toLowerCase() === "adm";
                const agora = new Date();
                const pagoAtivo = u.statusSubscricao === "ativo" && u.pagoAte && new Date(u.pagoAte) > agora;
                const trialDate = u.trialEndsAt ? new Date(u.trialEndsAt) : null;
                const diasRestantes = trialDate ? Math.max(0, Math.ceil((trialDate - agora) / (24 * 60 * 60 * 1000))) : 0;
                const paisAtual = u.pais || "PT";
                const nomePais = paisAtual === "BR" ? "Brasil" : (paisAtual === "OUTROS" ? "Outros" : "Portugal");
              %>
              <tr>
                <td><strong><%= u.nome %></strong></td>
                <td><%= u.email %></td>
                <td>
                  <div style="margin-bottom:4px;">
                    <strong><%= nomePais %> (<%= paisAtual %>)</strong> —
                    <span style="color:<%= u.telefone ? '#38bdf8' : '#94a3b8' %>;">
                      <%= u.telefone ? u.telefone : "Sem telefone" %>
                    </span>
                  </div>
                  <form action="/admin/utilizadores/<%= u._id %>/contacto" method="POST" class="form-contacto">
                    <select name="pais" class="select-pais">
                      <option value="PT" <%= paisAtual === "PT" ? "selected" : "" %>>Portugal (+351)</option>
                      <option value="BR" <%= paisAtual === "BR" ? "selected" : "" %>>Brasil (+55)</option>
                      <option value="OUTROS" <%= paisAtual === "OUTROS" ? "selected" : "" %>>Outros</option>
                    </select>
                    <input
                      type="text"
                      name="telefone"
                      value="<%= u.telefone || '' %>"
                      placeholder="Telefone"
                      class="input-tel"
                    />
                    <button type="submit" class="btn btn-secundario">Salvar</button>
                  </form>
                </td>
                <td><%= isAdminRow ? "Administrador" : "Utilizador" %></td>
                <td>
                  <% if (eAdmConta) { %>
                    <strong style="color:#38bdf8;">Acesso Admin (Sempre Liberado)</strong>
                  <% } else if (pagoAtivo) { %>
                    Ativo até <%= new Date(u.pagoAte).toLocaleDateString("pt-PT") %>
                  <% } else if (trialDate && trialDate > agora) { %>
                    Teste: <%= diasRestantes %> dia(s)
                  <% } else { %>
                    Expirado
                  <% } %>
                </td>
                <td>
  <% if (u.codigoPromocionalLiberado && u.codigoPromocional) { %>
    <strong style="color:#38bdf8; font-size:1.05rem; letter-spacing:2px;"><%= u.codigoPromocional %></strong><br>
    <span style="color:#38bdf8; font-size:0.78rem;">Disponibilizado</span>
  <% } else { %>
    <span style="color:#94a3b8;">Não disponibilizado</span>
  <% } %>
</td>
<td>
  <div class="acoes">
    <% if (!isAdminRow) { %>
      <form action="/admin/utilizadores/<%= u._id %>/renovar-teste" method="POST">
        <input type="number" name="dias" value="7" min="1" max="365" class="input-dias" />
        <button type="submit" class="btn">Renovar Dias</button>
      </form>
    <% } %>
    <form action="/admin/utilizadores/<%= u._id %>/promocional" method="POST">
      <button type="submit" class="btn btn-secundario">
        <%= (u.codigoPromocionalLiberado && u.codigoPromocional) ? "Bloquear Código" : "Disponibilizar Código" %>
      </button>
    </form>
    <form action="/admin/utilizadores/<%= u._id %>/role" method="POST">
      <button type="submit" class="btn btn-secundario">
        <%= isAdminRow ? "Tornar Utilizador" : "Tornar Admin" %>
      </button>
    </form>
    <% if (String(u._id) !== String(utilizador.id)) { %>
      <form action="/admin/utilizadores/<%= u._id %>/apagar" method="POST" onsubmit="return confirm('Apagar utilizador?');">
        <button type="submit" class="btn btn-sair">Apagar</button>
      </form>
    <% } %>
  </div>
</td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>