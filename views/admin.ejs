<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Dashboard do Admin</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background: #050811;
      color: #e2e8f0;
      font-family: Arial, Helvetica, sans-serif;
    }

    /* === TOPBAR ADMIN === */
    .topbar {
      position: sticky;
      top: 0;
      z-index: 30;
      background: rgba(8, 14, 28, 0.96);
      border-bottom: 1px solid #1e293b;
      backdrop-filter: blur(8px);
      padding: 12px 20px;
    }

    .topbar-inner {
      max-width: 1380px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .brand {
      color: #38bdf8;
      font-size: 1.3rem;
      font-weight: 800;
      text-decoration: none;
    }

    .admin-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .admin-badge {
      font-size: 0.84rem;
      color: #94a3b8;
      margin-right: 4px;
    }

    .btn {
      background: #0284c7;
      color: #ffffff;
      border: none;
      border-radius: 7px;
      padding: 8px 13px;
      font-size: 0.84rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background-color 0.15s ease;
    }

    .btn:hover { background: #0ea5e9; }

    .btn-ghost {
      background: #0b1324;
      color: #cbd5e1;
      border: 1px solid #1e293b;
    }

    .btn-ghost:hover,
    .btn-ghost.ativo {
      background: #082f49;
      border-color: #38bdf8;
      color: #38bdf8;
    }

    .btn-danger {
      background: #7f1d1d;
      color: #fecaca;
    }

    .btn-danger:hover {
      background: #991b1b;
      color: #ffffff;
    }

    .btn-sm {
      padding: 6px 10px;
      font-size: 0.78rem;
    }

    /* === CONTAINER PRINCIPAL === */
    .container {
      max-width: 1380px;
      margin: 18px auto 34px auto;
      padding: 0 20px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .nav-tabs {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .card {
      background: #0b1324;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 18px;
      box-shadow: 0 0 24px rgba(2, 132, 199, 0.1);
    }

    .card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 14px;
      padding-bottom: 10px;
      border-bottom: 1px solid #1e293b;
      flex-wrap: wrap;
    }

    .card-title {
      margin: 0;
      color: #38bdf8;
      font-size: 1.08rem;
    }

    .secao-oculta {
      display: none;
    }

    /* === TABELAS === */
    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.86rem;
    }

    th, td {
      padding: 10px 11px;
      text-align: left;
      border-bottom: 1px solid #1e293b;
      vertical-align: middle;
    }

    th {
      color: #94a3b8;
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    input, select {
      background: #020617;
      color: #f8fafc;
      border: 1px solid #334155;
      border-radius: 6px;
      padding: 7px 9px;
      font-size: 0.84rem;
    }

    input:focus, select:focus {
      outline: none;
      border-color: #38bdf8;
    }

    .inline-form {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .acoes-stack {
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-width: 150px;
    }

    .estado-confirmado {
      color: #38bdf8;
      font-weight: 700;
    }

    .estado-pendente {
      color: #fbbf24;
      font-weight: 700;
    }

    /* === COMUNICAÇÃO COM CLIENTE (WHATSAPP / TELEGRAM / CHAT DIRETO) === */
    .comm-grid {
      display: grid;
      grid-template-columns: minmax(280px, 1fr) minmax(340px, 1.4fr);
      gap: 16px;
    }

    @media (max-width: 900px) {
      .comm-grid {
        grid-template-columns: 1fr;
      }
    }

    .comm-box {
      background: #060b16;
      border: 1px solid #1e293b;
      border-radius: 8px;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .comm-channels {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .chat-box {
      background: #020617;
      border: 1px solid #1e293b;
      border-radius: 8px;
      padding: 12px;
      min-height: 130px;
      max-height: 220px;
      overflow-y: auto;
      font-size: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .msg-item {
      padding: 7px 10px;
      border-radius: 7px;
      background: #0b1324;
      border: 1px solid #1e293b;
    }

    .msg-admin {
      border-color: #0284c7;
      background: #082f49;
    }
  </style>
</head>
<body>
  <%
    const comprasSafe = (typeof compras !== "undefined" && Array.isArray(compras)) ? compras : [];
    const utilizadoresSafe = (typeof utilizadores !== "undefined" && Array.isArray(utilizadores)) ? utilizadores : [];
    const adminNome = (typeof utilizador !== "undefined" && utilizador && utilizador.nome) ? utilizador.nome : "Admin";
  %>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/admin" class="brand">AlphaTV • Dashboard Admin</a>
      <div class="admin-actions">
        <span class="admin-badge">Admin: <strong><%= adminNome %></strong></span>
        <a href="/player" class="btn btn-ghost">Abrir Player</a>
        <a href="/logout" class="btn btn-danger">Sair</a>
      </div>
    </div>
  </header>

  <main class="container">
    <!-- NAVEGAÇÃO RÁPIDA ENTRE ÁREAS DO ADMIN -->
    <nav class="nav-tabs" aria-label="Secções do administrador">
      <button type="button" class="btn btn-ghost ativo" data-sec="todas" onclick="mostrarSecao('todas', this)">Todas as Secções</button>
      <button type="button" class="btn btn-ghost" data-sec="pagamentos" onclick="mostrarSecao('pagamentos', this)">Pagamentos</button>
      <button type="button" class="btn btn-ghost" data-sec="utilizadores" onclick="mostrarSecao('utilizadores', this)">Utilizadores</button>
      <button type="button" class="btn btn-ghost" data-sec="comunicacao" onclick="mostrarSecao('comunicacao', this)">WhatsApp / Telegram / Chat</button>
    </nav>

    <!-- 1. PAGAMENTOS E CONFIRMAÇÃO DE ACESSO -->
    <section id="sec-pagamentos" class="card">
      <div class="card-header">
        <h2 class="card-title">Pagamentos e Confirmação de Acesso</h2>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Recibo</th>
              <th>Utilizador</th>
              <th>Plano</th>
              <th>Método</th>
              <th>Valor</th>
              <th>Estado</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody>
            <% if (comprasSafe.length === 0) { %>
              <tr>
                <td colspan="7" style="color:#94a3b8;">Nenhum pedido de pagamento registado.</td>
              </tr>
            <% } else { %>
              <% comprasSafe.forEach(function(compra) {
                const confirmado = String(compra.status || "").toLowerCase() === "confirmado" && compra.confirmadoPorAdmin !== false;
              %>
                <tr>
                  <td><strong><%= compra.codigoRecibo || "-" %></strong></td>
                  <td>
                    <%= compra.nomeUtilizador || "Utilizador" %>
                    <% if (compra.emailUtilizador) { %>
                      <div style="font-size:0.78rem; color:#94a3b8;">(<%= compra.emailUtilizador %>)</div>
                    <% } %>
                  </td>
                  <td><%= compra.nomePlano || (compra.planoDias ? compra.planoDias + " dias" : "-") %></td>
                  <td><%= compra.metodoPagamento || "-" %></td>
                  <td><%= Number(compra.valorFinal ?? compra.valorBase ?? 0).toFixed(2) %> <%= compra.moeda || "EUR" %></td>
                  <td>
                    <% if (confirmado) { %>
                      <span class="estado-confirmado">Confirmado</span>
                    <% } else { %>
                      <span class="estado-pendente">Pendente</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="acoes-stack">
                      <% if (!confirmado && compra.codigoRecibo) { %>
                        <form action="/admin/confirmar-pagamento/<%= encodeURIComponent(compra.codigoRecibo) %>" method="POST" style="margin:0;">
                          <button type="submit" class="btn btn-sm" style="width:100%; justify-content:center;">Confirmar Pagamento</button>
                        </form>
                      <% } %>
                      <% if (confirmado && compra.codigoRecibo) { %>
                        <a href="/recibo/<%= encodeURIComponent(compra.codigoRecibo) %>" class="btn btn-ghost btn-sm" style="justify-content:center;">Ver Recibo</a>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 2. COMUNICAÇÃO COM O CLIENTE (WHATSAPP, TELEGRAM E CHAT DIRETO) -->
    <section id="sec-comunicacao" class="card">
      <div class="card-header">
        <h2 class="card-title">Comunicação com o Cliente • WhatsApp, Telegram e Chat Direto</h2>
      </div>

      <div class="comm-grid">
        <!-- CANAIS EXTERNOS: WHATSAPP & TELEGRAM -->
        <div class="comm-box">
          <strong style="color:#38bdf8; font-size:0.92rem;">Canais Externos (WhatsApp / Telegram)</strong>

          <label for="commClienteSelect" style="font-size:0.8rem; color:#94a3b8;">Selecionar cliente</label>
          <select id="commClienteSelect" onchange="sincronizarClienteComm()">
            <option value="">-- Escolher cliente da lista --</option>
            <% utilizadoresSafe.forEach(function(u) { %>
              <option
                value="<%= u._id %>"
                data-nome="<%= u.nome || '' %>"
                data-email="<%= u.email || '' %>"
                data-telefone="<%= u.telefone || '' %>"
              >
                <%= u.nome || u.email %> (<%= u.telefone || "sem telefone" %>)
              </option>
            <% }); %>
          </select>

          <input id="commTelefoneManual" type="text" placeholder="Telefone WhatsApp (ex: +351912345678)" />
          <input id="commTelegramUser" type="text" placeholder="Utilizador ou link Telegram (ex: @cliente ou https://t.me/...)" />
          <input id="commMensagemRapida" type="text" placeholder="Mensagem padrão (ex: Olá, o seu acesso AlphaTV está ativo!)" />

          <div class="comm-channels">
            <button type="button" class="btn btn-sm" onclick="abrirWhatsAppCliente()">Abrir WhatsApp</button>
            <button type="button" class="btn btn-ghost btn-sm" onclick="abrirTelegramCliente()">Abrir Telegram</button>
          </div>
        </div>

        <!-- CHAT DIRETO COM O CLIENTE -->
        <div class="comm-box">
          <strong style="color:#38bdf8; font-size:0.92rem;">Chat Direto com o Cliente</strong>
          <div id="chatClienteLog" class="chat-box">
            <div class="msg-item">
              <strong style="color:#38bdf8;">Sistema:</strong> Selecione um cliente e envie uma mensagem direta de suporte ou confirmação.
            </div>
          </div>
          <form class="inline-form" onsubmit="enviarChatAdmin(event)" style="width:100%;">
            <input id="chatAdminInput" type="text" placeholder="Escrever resposta direta para o cliente..." style="flex:1;" required />
            <button type="submit" class="btn btn-sm">Enviar no Chat</button>
          </form>
        </div>
      </div>
    </section>

    <!-- 3. UTILIZADORES, PAÍS/TELEFONE, DIAS GRATUITOS E CÓDIGO PROMOCIONAL -->
    <section id="sec-utilizadores" class="card">
      <div class="card-header">
        <h2 class="card-title">Utilizadores, País/Telefone, Dias Gratuitos e Código Promocional</h2>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Nome</th>
              <th>E-mail</th>
              <th>País / Telefone</th>
              <th>Perfil</th>
              <th>Acesso / Dias</th>
              <th>Código Convite</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% if (utilizadoresSafe.length === 0) { %>
              <tr>
                <td colspan="7" style="color:#94a3b8;">Nenhum utilizador encontrado.</td>
              </tr>
            <% } else { %>
              <% utilizadoresSafe.forEach(function(u) {
                const paisAtual = u.pais || "PT";
                const roleAtual = String(u.role || "Utilizador");
              %>
                <tr>
                  <td><strong><%= u.nome || "-" %></strong></td>
                  <td><%= u.email || "-" %></td>
                  <td>
                    <form action="/admin/utilizador/<%= u._id %>/contacto" method="POST" class="inline-form">
                      <select name="pais">
                        <option value="PT" <%= paisAtual === "PT" ? "selected" : "" %>>Portugal (+351)</option>
                        <option value="BR" <%= paisAtual === "BR" ? "selected" : "" %>>Brasil (+55)</option>
                        <option value="OUTROS" <%= paisAtual === "OUTROS" ? "selected" : "" %>>Internacional</option>
                      </select>
                      <input type="text" name="telefone" value="<%= u.telefone || '' %>" style="width:135px;" />
                      <button type="submit" class="btn btn-ghost btn-sm">Salvar</button>
                    </form>
                  </td>
                  <td><%= roleAtual %></td>
                  <td>
                    <span class="estado-pendente"><%= u.statusSubscricao || "trial" %></span>
                    <% if (u.pagoAte) { %>
                      <div style="font-size:0.78rem; color:#94a3b8;">Até <%= new Date(u.pagoAte).toLocaleDateString("pt-PT") %></div>
                    <% } %>
                  </td>
                  <td>
                    <% if (u.codigoPromocionalLiberado && u.codigoPromocional) { %>
                      <strong style="color:#38bdf8;"><%= u.codigoPromocional %></strong>
                    <% } else { %>
                      <span style="color:#94a3b8;">Não disponibilizado</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="acoes-stack">
                      <form action="/admin/utilizador/<%= u._id %>/dias" method="POST" class="inline-form">
                        <input type="number" name="dias" value="7" min="1" max="365" style="width:62px;" />
                        <button type="submit" class="btn btn-sm">Renovar Dias</button>
                      </form>

                      <form action="/admin/utilizador/<%= u._id %>/codigo-promocional" method="POST" style="margin:0;">
                        <button type="submit" class="btn btn-ghost btn-sm" style="width:100%; justify-content:center;">Disponibilizar Código</button>
                      </form>

                      <% if (roleAtual.toLowerCase() !== "administrador") { %>
                        <form action="/admin/utilizador/<%= u._id %>/tornar-admin" method="POST" style="margin:0;">
                          <button type="submit" class="btn btn-ghost btn-sm" style="width:100%; justify-content:center;">Tornar Admin</button>
                        </form>
                      <% } %>

                      <form action="/admin/utilizador/<%= u._id %>/apagar" method="POST" onsubmit="return confirm('Apagar este utilizador?');" style="margin:0;">
                        <button type="submit" class="btn btn-danger btn-sm" style="width:100%; justify-content:center;">Apagar</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    function mostrarSecao(secao, btnClicado) {
      const pag = document.getElementById("sec-pagamentos");
      const comm = document.getElementById("sec-comunicacao");
      const users = document.getElementById("sec-utilizadores");

      if (pag) pag.classList.toggle("secao-oculta", !(secao === "todas" || secao === "pagamentos"));
      if (comm) comm.classList.toggle("secao-oculta", !(secao === "todas" || secao === "comunicacao"));
      if (users) users.classList.toggle("secao-oculta", !(secao === "todas" || secao === "utilizadores"));

      document.querySelectorAll(".nav-tabs .btn-ghost").forEach((b) => b.classList.remove("ativo"));
      if (btnClicado) btnClicado.classList.add("ativo");
    }

    function sincronizarClienteComm() {
      const sel = document.getElementById("commClienteSelect");
      if (!sel) return;
      const opt = sel.options[sel.selectedIndex];
      const telInput = document.getElementById("commTelefoneManual");
      if (opt && telInput && opt.dataset.telefone) {
        telInput.value = opt.dataset.telefone;
      }
    }

    function abrirWhatsAppCliente() {
      const telRaw = (document.getElementById("commTelefoneManual")?.value || "").replace(/\D/g, "");
      const msg = (document.getElementById("commMensagemRapida")?.value || "Olá, suporte AlphaTV.").trim();
      if (!telRaw) {
        alert("Informe ou selecione um número de telefone válido para o WhatsApp.");
        return;
      }
      const url = "https://wa.me/" + telRaw + "?text=" + encodeURIComponent(msg);
      window.open(url, "_blank", "noopener");
    }

    function abrirTelegramCliente() {
      const tgRaw = (document.getElementById("commTelegramUser")?.value || "").trim();
      const msg = (document.getElementById("commMensagemRapida")?.value || "Olá, suporte AlphaTV.").trim();