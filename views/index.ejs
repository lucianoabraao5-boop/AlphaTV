<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Entrar ou Criar Conta</title>
  <style>
    * { box-sizing: border-box; }

    body {
      background-color: #050811;
      color: #e2e8f0;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 24px;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }

    /* === ANIMAÇÃO DE TV AO FUNDO === */
    .tv-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
      background:
        radial-gradient(circle at 50% 35%, rgba(14, 165, 233, 0.14), rgba(5, 8, 17, 0.96) 72%),
        repeating-linear-gradient(
          to bottom,
          rgba(56, 189, 248, 0.04) 0px,
          rgba(56, 189, 248, 0.04) 2px,
          transparent 2px,
          transparent 5px
        );
    }

    .tv-scanline {
      position: absolute;
      left: 0;
      right: 0;
      height: 120px;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(56, 189, 248, 0.08) 50%,
        transparent 100%
      );
      animation: tvScan 7s linear infinite;
    }

    .tv-pulse-grid {
      position: absolute;
      inset: -20%;
      background-image:
        linear-gradient(to right, rgba(2, 132, 199, 0.07) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(2, 132, 199, 0.07) 1px, transparent 1px);
      background-size: 48px 48px;
      animation: tvDrift 16s ease-in-out infinite alternate;
    }

    .tv-signal-tag {
      position: fixed;
      bottom: 14px;
      right: 18px;
      z-index: 1;
      pointer-events: none;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      color: rgba(56, 189, 248, 0.55);
      display: flex;
      align-items: center;
      gap: 7px;
      text-transform: uppercase;
    }

    .tv-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #38bdf8;
      box-shadow: 0 0 10px #38bdf8;
      animation: tvBlink 1.8s infinite;
    }

    @keyframes tvScan {
      0% { transform: translateY(-160px); }
      100% { transform: translateY(110vh); }
    }

    @keyframes tvDrift {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(-24px, -18px) scale(1.04); }
    }

    @keyframes tvBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.25; }
    }

    .conteudo-principal {
      position: relative;
      z-index: 1;
    }

    .topo {
      max-width: 960px;
      margin: 0 auto 22px auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .marca {
      color: #38bdf8;
      font-size: 1.5rem;
      font-weight: bold;
      text-shadow: 0 0 18px rgba(56, 189, 248, 0.35);
    }

    .grid-acesso {
      max-width: 960px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }

    .card {
      background: rgba(11, 19, 36, 0.92);
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 22px;
      box-shadow: 0 0 26px rgba(0, 180, 255, 0.12);
      backdrop-filter: blur(4px);
    }

    h2 {
      margin: 0 0 14px 0;
      color: #38bdf8;
      font-size: 1.2rem;
    }

    label {
      display: block;
      font-size: 0.85rem;
      color: #94a3b8;
      margin: 10px 0 4px 0;
    }

    input, select {
      width: 100%;
      padding: 10px 12px;
      border-radius: 6px;
      border: 1px solid #334155;
      background: #020617;
      color: #f8fafc;
      font-size: 0.92rem;
    }

    .grupo-telefone {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .prefixo-pais {
      background: #082f49;
      color: #38bdf8;
      border: 1px solid #0284c7;
      border-radius: 6px;
      padding: 10px 10px;
      font-weight: bold;
      font-size: 0.88rem;
      white-space: nowrap;
    }

    .dica-pais {
      font-size: 0.78rem;
      color: #94a3b8;
      margin-top: 4px;
    }

    .btn {
      margin-top: 16px;
      width: 100%;
      background: #0284c7;
      color: #ffffff;
      border: none;
      padding: 11px 14px;
      border-radius: 6px;
      font-size: 0.95rem;
      font-weight: bold;
      cursor: pointer;
    }

    .btn:hover { background: #0ea5e9; }

    .barra-recuperar {
      margin-top: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.88rem;
    }

    .link-recuperar {
      color: #38bdf8;
      text-decoration: underline;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
      font-size: 0.88rem;
      font-weight: bold;
    }

    .painel-recuperacao {
      max-width: 960px;
      margin: 20px auto 0 auto;
      display: none;
    }

    .painel-recuperacao.visivel { display: block; }

    .qr-box {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      align-items: center;
      background: #020617;
      border: 1px solid #1e293b;
      border-radius: 8px;
      padding: 16px;
      margin-top: 12px;
    }

    .qr-canvas-wrap {
      background: #ffffff;
      padding: 10px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .qr-meta {
      flex: 1;
      min-width: 240px;
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .alerta-erro {
      max-width: 960px;
      margin: 0 auto 14px auto;
      background: #7f1d1d;
      color: #fecaca;
      border: 1px solid #dc2626;
      padding: 12px 16px;
      border-radius: 8px;
    }
  </style>
</head>
<body>
  <div class="tv-bg" aria-hidden="true">
    <div class="tv-pulse-grid"></div>
    <div class="tv-scanline"></div>
  </div>
  <div class="tv-signal-tag" aria-hidden="true">
    <span class="tv-dot"></span>
    <span>ALPHATV • TV SIGNAL ACTIVE</span>
  </div>

  <div class="conteudo-principal">
    <%
      const qrObj = (typeof qrDados !== "undefined" && qrDados) ? qrDados : null;
      const mostrarQrInicial = Boolean(typeof abrirQrInicial !== "undefined" && abrirQrInicial && qrObj);
    %>

    <div class="topo">
      <div class="marca">AlphaTV</div>
      <div style="font-size: 0.86rem; color: #94a3b8;">7 dias gratuitos • Recuperação por QR Code no logout</div>
    </div>

    <% if (typeof erro !== "undefined" && erro) { %>
      <div class="alerta-erro"><%= erro %></div>
    <% } %>

    <div class="grid-acesso">
      <div class="card">
        <h2>Entrar no AlphaTV</h2>
        <form action="/login" method="POST">
          <label for="loginEmail">O teu e-mail</label>
          <input
            type="email"
            id="loginEmail"
            name="email"
            placeholder="O teu e-mail"
            value="<%= qrObj && qrObj.email ? qrObj.email : '' %>"
            required
          />

          <label for="loginPassword">Palavra-passe</label>
          <input
            type="password"
            id="loginPassword"
            name="password"
            placeholder="Palavra-passe"
            required
          />

          <button type="submit" class="btn">Entrar</button>
        </form>

        <div class="barra-recuperar">
          <span style="color:#94a3b8;">Consultar dados / QR da conta?</span>
          <button type="button" class="link-recuperar" onclick="alternarRecuperacao(true)">
            Recuperar acesso
          </button>
        </div>
      </div>

      <div class="card">
        <h2>Criar Conta</h2>
        <form action="/cadastrar" method="POST">
          <label for="cadNome">Nome completo</label>
          <input type="text" id="cadNome" name="nome" placeholder="Nome completo" required />

          <label for="cadEmail">E-mail</label>
          <input type="email" id="cadEmail" name="email" placeholder="E-mail" required />

          <label for="cadPassword">Criar palavra-passe</label>
          <input type="password" id="cadPassword" name="password" placeholder="Criar palavra-passe" required />

          <label for="cadPais">País de origem / instalação</label>
          <select id="cadPais" name="pais" onchange="configurarCampoTelefone('cad')">
            <option value="PT">Portugal (+351)</option>
            <option value="BR">Brasil (+55)</option>
            <option value="OUTROS">Outros países (Internacional)</option>
          </select>

          <label for="cadTelefone">Telefone de contacto</label>
          <div class="grupo-telefone">
            <span id="cadPrefixo" class="prefixo-pais">+351</span>
            <input type="text" id="cadTelefone" name="telefone" placeholder="Ex: 912345678" required />
          </div>
          <div id="cadDica" class="dica-pais">Portugal: 9 dígitos (ex: 912345678).</div>

          <label for="cadConvite">Código promocional de convite (opcional)</label>
          <input type="text" id="cadConvite" name="codigoConvite" placeholder="Código de 4 dígitos (se tiver)" />

          <button type="submit" class="btn">Registar e Assistir</button>
        </form>
      </div>
    </div>

    <div id="painelRecuperacao" class="card painel-recuperacao <%= mostrarQrInicial ? 'visivel' : '' %>">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:10px;">
        <h2 style="margin:0;">Recuperar acesso • Dados em QR Code</h2>
        <button type="button" class="link-recuperar" onclick="alternarRecuperacao(false)">Ocultar</button>
      </div>

      <% if (qrObj) { %>
        <div class="qr-box">
          <div class="qr-canvas-wrap">
            <canvas id="qrCanvas" width="180" height="180"></canvas>
          </div>
          <div class="qr-meta">
            <div><strong>Dados da última sessão (Logout):</strong></div>
            <div>Nome: <strong><%= qrObj.nome %></strong></div>
            <div>E-mail: <strong><%= qrObj.email %></strong></div>
            <div>País / Telefone: <strong><%= qrObj.pais %></strong> <%= qrObj.telefone ? ("• " + qrObj.telefone) : "" %></div>
            <div>Estado: <strong><%= qrObj.statusSubscricao %></strong><%= qrObj.pagoAte ? (" (até " + qrObj.pagoAte + ")") : "" %></div>
            <% if (qrObj.codigoPromocional) { %>
              <div>Código Promocional: <strong style="color:#38bdf8;"><%= qrObj.codigoPromocional %></strong></div>
            <% } %>
            <div style="margin-top:10px; font-size:0.78rem; color:#94a3b8; word-break:break-all;">
              Conteúdo QR: <span id="qrPayloadTexto"><%= JSON.stringify({ nome: qrObj.nome, email: qrObj.email, pais: qrObj.pais, telefone: qrObj.telefone, codigoPromocional: qrObj.codigoPromocional || null }) %></span>
            </div>
          </div>
        </div>
      <% } else { %>
        <p style="color:#94a3b8; margin-top:10px;">
          Inicia sessão e faz <strong>Sair (Logout)</strong> para gerar e disponibilizar aqui o QR Code com os dados da tua conta.
        </p>
      <% } %>
    </div>
  </div>

  <script>
    function alternarRecuperacao(mostrar) {
      const painel = document.getElementById("painelRecuperacao");
      if (!painel) return;
      if (mostrar) {
        painel.classList.add("visivel");
        painel.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } else {
        painel.classList.remove("visivel");
      }
    }

    function configurarCampoTelefone(prefixoId) {
      const sel = document.getElementById(prefixoId + "Pais");
      const badge = document.getElementById(prefixoId + "Prefixo");
      const input = document.getElementById(prefixoId + "Telefone");
      const dica = document.getElementById(prefixoId + "Dica");
      if (!sel || !badge || !input) return;

      if (sel.value === "PT") {
        badge.textContent = "+351";
        input.placeholder = "Ex: 912345678";
        if (dica) dica.textContent = "Portugal: 9 dígitos (ex: 912345678).";
      } else if (sel.value === "BR") {
        badge.textContent = "+55";
        input.placeholder = "Ex: 11987654321";
        if (dica) dica.textContent = "Brasil: DDD + número (10 ou 11 dígitos, ex: 11987654321).";
      } else {
        badge.textContent = "INTL";
        input.placeholder = "Ex: +447700900077";
        if (dica) dica.textContent = "Outros países: número completo com código internacional.";
      }
    }

    function desenharQrSimbolico(canvas, texto) {
      if (!canvas || !texto) return;
      const ctx = canvas.getContext("2d");
      const size = canvas.width;
      const cells = 21;
      const cell = Math.floor(size / cells);
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, size, size);

      function desenharOlho(ox, oy) {
        ctx.fillStyle = "#050811";
        ctx.fillRect(ox * cell, oy * cell, 7 * cell, 7 * cell);
        ctx.fillStyle = "#ffffff";
        ctx.fillRect((ox + 1) * cell, (oy + 1) * cell, 5 * cell, 5 * cell);
        ctx.fillStyle = "#0284c7";
        ctx.fillRect((ox + 2) * cell, (oy + 2) * cell, 3 * cell, 3 * cell);
      }

      desenharOlho(0, 0);
      desenharOlho(cells - 7, 0);
      desenharOlho(0, cells - 7);

      let hash = 2166136261;
      for (let i = 0; i < texto.length; i++) {
        hash ^= texto.charCodeAt(i);
        hash = Math.imul(hash, 16777619);
      }

      for (let r = 0; r < cells; r++) {
        for (let c = 0; c < cells; c++) {
          const emOlhoSupEsq = r < 8 && c < 8;
          const emOlhoSupDir = r < 8 && c >= cells - 8;
          const emOlhoInfEsq = r >= cells - 8 && c < 8;
          if (emOlhoSupEsq || emOlhoSupDir || emOlhoInfEsq) continue;

          const idx = r * cells + c + texto.charCodeAt(r % texto.length);
          const bit = ((hash >>> (idx % 24)) ^ (r * 31 + c * 17 + texto.charCodeAt(idx % texto.length))) & 1;
          if (bit === 1) {
            ctx.fillStyle = "#050811";
            ctx.fillRect(c * cell, r * cell, cell, cell);
          }
        }
      }
    }

    configurarCampoTelefone("cad");
    const payloadEl = document.getElementById("qrPayloadTexto");
    const qrCanvas = document.getElementById("qrCanvas");
    if (payloadEl && qrCanvas) {
      desenharQrSimbolico(qrCanvas, payloadEl.textContent);
    }
  </script>
</body>
</html>