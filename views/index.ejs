<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Entrar</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background: #07090e;
      color: #f1f5f9;
      font-family: Arial, Helvetica, sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .auth-shell {
      width: 100%;
      max-width: 410px;
    }

    .auth-card {
      background: #10141d;
      border: 1px solid #1e2536;
      border-radius: 16px;
      padding: 32px 26px 26px 26px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.65);
    }

    .brand-header {
      text-align: center;
      margin-bottom: 24px;
    }

    .brand-logo {
      font-size: 2rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      color: #38bdf8;
      margin: 0 0 8px 0;
    }

    .brand-subtitle {
      margin: 0;
      font-size: 0.9rem;
      color: #94a3b8;
    }

    .field-group {
      margin-bottom: 14px;
    }

    .field-input,
    .field-select {
      width: 100%;
      height: 46px;
      padding: 0 14px;
      border-radius: 10px;
      border: 1px solid #262f45;
      background: #171c28;
      color: #f8fafc;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .field-input:focus,
    .field-select:focus {
      border-color: #38bdf8;
      background: #1b2232;
    }

    .phone-row {
      display: flex;
      gap: 8px;
    }

    .phone-prefix {
      height: 46px;
      padding: 0 12px;
      border-radius: 10px;
      background: #0b2436;
      border: 1px solid #0284c7;
      color: #38bdf8;
      font-weight: 700;
      font-size: 0.88rem;
      display: inline-flex;
      align-items: center;
      white-space: nowrap;
    }

    .field-hint {
      margin-top: 5px;
      font-size: 0.78rem;
      color: #94a3b8;
    }

    .btn-primary {
      width: 100%;
      height: 46px;
      margin-top: 6px;
      border: none;
      border-radius: 10px;
      background: #ef4444;
      color: #ffffff;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }

    .btn-primary:hover {
      background: #f87171;
    }

    .btn-install {
      width: 100%;
      height: 44px;
      margin-top: 14px;
      border-radius: 10px;
      border: 1px solid #262f45;
      background: #171c28;
      color: #e2e8f0;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .btn-install:hover {
      background: #1f2636;
      border-color: #38bdf8;
    }

    .auth-footer-links {
      margin-top: 18px;
      text-align: center;
      font-size: 0.86rem;
      color: #94a3b8;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .link-btn {
      background: none;
      border: none;
      padding: 0;
      color: #38bdf8;
      font-size: 0.86rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
    }

    .link-btn:hover {
      text-decoration: underline;
    }

    .box-switch {
      display: none;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px solid #1e2536;
    }

    .box-switch.visivel {
      display: block;
    }

    .qr-panel {
      margin-top: 18px;
      padding-top: 18px;
      border-top: 1px solid #1e2536;
      display: none;
    }

    .qr-panel.visivel {
      display: block;
    }

    .qr-card {
      background: #151a26;
      border: 1px solid #242d42;
      border-radius: 12px;
      padding: 16px;
      text-align: center;
    }

    .qr-frame {
      background: #ffffff;
      padding: 10px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 12px;
    }

    .qr-details {
      font-size: 0.85rem;
      line-height: 1.5;
      color: #cbd5e1;
      text-align: left;
    }

    .btn-read-qr {
      width: 100%;
      margin-top: 10px;
      height: 38px;
      border-radius: 8px;
      border: 1px solid #0284c7;
      background: #0b2436;
      color: #38bdf8;
      font-size: 0.84rem;
      font-weight: 700;
      cursor: pointer;
    }

    .btn-read-qr:hover {
      background: #0f3550;
    }

    .alert-error {
      margin-bottom: 14px;
      padding: 10px 12px;
      border-radius: 10px;
      background: rgba(127, 29, 29, 0.45);
      border: 1px solid #dc2626;
      color: #fecaca;
      font-size: 0.85rem;
      text-align: center;
    }

    .alert-info {
      margin-top: 10px;
      padding: 10px 12px;
      border-radius: 10px;
      background: rgba(14, 165, 233, 0.12);
      border: 1px solid rgba(56, 189, 248, 0.35);
      color: #bae6fd;
      font-size: 0.82rem;
      text-align: center;
      display: none;
    }
  </style>
  <script src="/js/qrcode.min.js"></script>
</head>
<body>
  <%
    const qrObj = (typeof qrDados !== "undefined" && qrDados) ? qrDados : null;
    const mostrarQrInicial = Boolean(typeof abrirQrInicial !== "undefined" && abrirQrInicial && qrObj);
  %>

  <main class="auth-shell">
    <section class="auth-card">
      <header class="brand-header">
        <h1 class="brand-logo">AlphaTV</h1>
        <p class="brand-subtitle">Entre para acessar o conteúdo</p>
      </header>

      <% if (typeof erro !== "undefined" && erro) { %>
        <div class="alert-error"><%= erro %></div>
      <% } %>

      <!-- FORMULÁRIO PRINCIPAL DE LOGIN -->
      <div id="viewLogin">
        <form action="/login" method="POST">
          <div class="field-group">
            <input
              type="email"
              id="loginEmail"
              name="email"
              class="field-input"
              placeholder="Usuário (e-mail)"
              value="<%= qrObj && qrObj.email ? qrObj.email : '' %>"
              required
            />
          </div>

          <div class="field-group">
            <input
              type="password"
              id="loginPassword"
              name="password"
              class="field-input"
              placeholder="••••••••"
              required
            />
          </div>

          <button type="submit" class="btn-primary">ENTRAR</button>
        </form>

        <div class="auth-footer-links">
          <div>
            Não tem conta?
            <button type="button" class="link-btn" onclick="alternarVista('cadastro')">Cadastre-se</button>
          </div>
          <div>
            <button type="button" class="link-btn" onclick="alternarQr(true)">
              Recuperar senha via QR Code
            </button>
          </div>
        </div>
      </div>

      <!-- FORMULÁRIO DE CADASTRO (OCULTO ATÉ CLICAR EM CADASTRE-SE) -->
      <div id="viewCadastro" class="box-switch">
        <form action="/cadastrar" method="POST">
          <div class="field-group">
            <input type="text" id="cadNome" name="nome" class="field-input" placeholder="Nome completo" required />
          </div>

          <div class="field-group">
            <input type="email" id="cadEmail" name="email" class="field-input" placeholder="E-mail" required />
          </div>

          <div class="field-group">
            <input type="password" id="cadPassword" name="password" class="field-input" placeholder="Criar palavra-passe" required />
          </div>

          <div class="field-group">
            <select id="cadPais" name="pais" class="field-select" onchange="configurarCampoTelefone('cad')">
              <option value="PT">Portugal (+351)</option>
              <option value="BR">Brasil (+55)</option>
              <option value="OUTROS">Outros países (Internacional)</option>
            </select>
          </div>

          <div class="field-group">
            <div class="phone-row">
              <span id="cadPrefixo" class="phone-prefix">+351</span>
              <input type="text" id="cadTelefone" name="telefone" class="field-input" placeholder="Ex: 912345678" required />
            </div>
            <div id="cadDica" class="field-hint">Portugal: 9 dígitos (ex: 912345678).</div>
          </div>

          <div class="field-group">
            <input type="text" id="cadConvite" name="codigoConvite" class="field-input" placeholder="Código promocional de convite (opcional)" />
          </div>

          <button type="submit" class="btn-primary">CRIAR CONTA</button>
        </form>

        <div class="auth-footer-links">
          <button type="button" class="link-btn" onclick="alternarVista('login')">Voltar ao login</button>
        </div>
      </div>

      <!-- BOTÃO INSTALAR APLICATIVO -->
      <button type="button" id="btnInstalarApp" class="btn-install" onclick="instalarAplicativo()">
        <span>&#8681;</span>
        <span>Instalar aplicativo</span>
      </button>
      <div id="avisoInstalar" class="alert-info"></div>

      <!-- PAINEL QR CODE DE RECUPERAÇÃO -->
      <div id="painelRecuperacao" class="qr-panel <%= mostrarQrInicial ? 'visivel' : '' %>">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
          <span style="font-size:0.88rem; font-weight:700; color:#38bdf8;">QR Code da Conta</span>
          <button type="button" class="link-btn" onclick="alternarQr(false)">Ocultar</button>
        </div>

        <div id="qrConteudoAtivo" class="qr-card" style="<%= qrObj ? '' : 'display:none;' %>">
          <div class="qr-frame">
            <canvas id="qrCanvas" width="200" height="200"></canvas>
          </div>
          <div id="qrDetalhesLista" class="qr-details">
            <div><strong>A aguardar leitura do QR Code</strong></div>
            <p style="color:#94a3b8; margin:6px 0 0 0;">
              Leia este QR Code com o telemóvel ou clique em <strong>Ler QR Code</strong> para obter o link de redefinição.
            </p>
            <button type="button" class="btn-read-qr" onclick="lerQrCodeAtual()">Ler QR Code</button>
          </div>
        </div>

        <p id="qrSemDadosMsg" style="color:#94a3b8; font-size:0.84rem; text-align:center; margin:8px 0 0 0; <%= qrObj ? 'display:none;' : '' %>">
          Inicia sessão e faz <strong>Logout</strong> para gerar o QR Code de recuperação.
        </p>
      </div>
    </section>
  </main>

  <script>
    let ultimoPayloadQrTexto = "";
    let ultimoDadosQr = null;
    let deferredPrompt = null;

    window.addEventListener("beforeinstallprompt", function (e) {
      e.preventDefault();
      deferredPrompt = e;
    });

    function instalarAplicativo() {
      const aviso = document.getElementById("avisoInstalar");
      if (deferredPrompt) {
        deferredPrompt.prompt();
        deferredPrompt.userChoice.finally(function () {
          deferredPrompt = null;
        });
        return;
      }
      if (aviso) {
        aviso.style.display = "block";
        aviso.textContent = "Para instalar no dispositivo, use o menu do navegador (\"Adicionar ao ecrã principal\" / \"Instalar aplicação\").";
      }
    }

    function alternarVista(vista) {
      const loginBox = document.getElementById("viewLogin");
      const cadBox = document.getElementById("viewCadastro");
      if (!loginBox || !cadBox) return;

      if (vista === "cadastro") {
        loginBox.style.display = "none";
        cadBox.classList.add("visivel");
      } else {
        cadBox.classList.remove("visivel");
        loginBox.style.display = "block";
      }
    }

    function alternarQr(mostrar) {
      const painel = document.getElementById("painelRecuperacao");
      if (!painel) return;
      if (mostrar) {
        painel.classList.add("visivel");
        painel.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } else {
        painel.classList.remove("visivel");
      }
    }

    function configurarCampoTelefone(prefixoId) {
      const sel = document.getElementById(prefixoId + "Pais");
      const badge = document.getElementById(prefixoId + "Prefixo");
      const input = document.getElementById(prefixoId + "Telefone");
      const dica = document.getElementById(prefixoId + "Dica");
      if (!sel || !badge || !input) return;

      if (sel.value === "PT") {
        badge.textContent = "+351";
        input.placeholder = "Ex: 912345678";
        if (dica) dica.textContent = "Portugal: 9 dígitos (ex: 912345678).";
      } else if (sel.value === "BR") {
        badge.textContent = "+55";
        input.placeholder = "Ex: 11987654321";
        if (dica) dica.textContent = "Brasil: DDD + número (10 ou 11 dígitos, ex: 11987654321).";
      } else {
        badge.textContent = "INTL";
        input.placeholder = "Ex: +447700900077";
        if (dica) dica.textContent = "Outros países: número completo com código internacional.";
      }
    }

    function escaparHtml(valor) {
      return String(valor || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }

    function mostrarEstadoAguardandoLeitura(erroMsg) {
      const detalhesEl = document.getElementById("qrDetalhesLista");
      if (!detalhesEl) return;

      const msg = erroMsg
        ? "<p style=\"color:#f87171; margin:6px 0 0 0;\">" + escaparHtml(erroMsg) + "</p>"
        : "<p style=\"color:#94a3b8; margin:6px 0 0 0;\">Leia este QR Code com o telemóvel ou clique em <strong>Ler QR Code</strong> para obter o link de redefinição.</p>";

      detalhesEl.innerHTML =
        "<div><strong>A aguardar leitura do QR Code</strong></div>" +
        msg +
        "<button type=\"button\" class=\"btn-read-qr\" onclick=\"lerQrCodeAtual()\">Ler QR Code</button>";
    }

    function atualizarDetalhesAposLeitura(leitura) {
      const detalhesEl = document.getElementById("qrDetalhesLista");
      if (!detalhesEl) return;

      const emailEscapado = escaparHtml(leitura.email || "Conta");
      const expiraEscapado = escaparHtml(leitura.expiraEm || "30 minutos");
      const urlEscapado = escaparHtml(leitura.url);

      detalhesEl.innerHTML =
        "<div><strong>Leitura do QR Code • Redefinir Senha</strong></div>" +
        "<div style=\"margin-top:6px;\"><strong>Conta:</strong> " + emailEscapado + "</div>" +
        "<div><strong>Validade:</strong> " + expiraEscapado + "</div>" +
        "<div style=\"margin-top:8px;\">" +
        "<a href=\"" + urlEscapado + "\" style=\"color:#38bdf8; word-break:break-all; font-size:0.8rem;\">" +
        urlEscapado +
        "</a>" +
        "</div>" +
        "<button type=\"button\" class=\"btn-read-qr\" onclick=\"lerQrCodeAtual()\">Ler QR Code novamente</button>";
    }

    async function lerCanvasComDetector(canvas) {
      if (typeof window.BarcodeDetector !== "function" || !canvas) {
        return null;
      }
      try {
        const formatos = await window.BarcodeDetector.getSupportedFormats();
        if (!Array.isArray(formatos) || !formatos.includes("qr_code")) {
          return null;
        }
        const detector = new window.BarcodeDetector({ formats: ["qr_code"] });
        const resultados = await detector.detect(canvas);
        if (Array.isArray(resultados) && resultados.length > 0 && resultados[0].rawValue) {
          return String(resultados[0].rawValue).trim();
        }
      } catch (e) {}
      return null;
    }

    async function lerQrCodeAtual() {
      const qrCanvas = document.getElementById("qrCanvas");
      if (!qrCanvas || !ultimoPayloadQrTexto) {
        mostrarEstadoAguardandoLeitura("Nenhum QR Code ativo para ler.");
        return;
      }

      const valorDetectado = await lerCanvasComDetector(qrCanvas);
      const textoFinal = valorDetectado || ultimoPayloadQrTexto;

      let emailLido = (ultimoDadosQr && ultimoDadosQr.email) || "";
      let tokenLido = (ultimoDadosQr && ultimoDadosQr.token) || "";

      try {
        const parsedUrl = new URL(textoFinal);
        const qEmail = parsedUrl.searchParams.get("email");
        const qToken = parsedUrl.searchParams.get("token");
        if (qEmail) emailLido = qEmail;
        if (qToken) tokenLido = qToken;
      } catch (e) {}

      atualizarDetalhesAposLeitura({
        url: textoFinal,
        email: emailLido,
        token: tokenLido,
        expiraEm: (ultimoDadosQr && ultimoDadosQr.expiraEm) || "30 minutos",
      });
    }

    function desenharQrNoCanvas(canvas, texto) {
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      if (!texto) return;

      const tentarDesenhar = (tentativas = 0) => {
        if (window.QRCode && typeof window.QRCode.toCanvas === "function") {
          window.QRCode.toCanvas(
            canvas,
            String(texto),
            {
              width: canvas.width,
              margin: 2,
              errorCorrectionLevel: "M",
              color: { dark: "#000000", light: "#ffffff" },
            },
            function (err) {
              if (err) console.error("Erro ao gerar QR Code:", err);
            }
          );
        } else if (tentativas < 25) {
          setTimeout(() => tentarDesenhar(tentativas + 1), 100);
        }
      };

      tentarDesenhar();
    }

    function renderizarDadosQr(dados) {
      const boxAtivo = document.getElementById("qrConteudoAtivo");
      const msgSemDados = document.getElementById("qrSemDadosMsg");
      const qrCanvas = document.getElementById("qrCanvas");
      if (!boxAtivo || !qrCanvas || !dados || !dados.email) return;

      ultimoDadosQr = dados;

      const baseRecuperacao =
        window.location.origin +
        "/recuperar-senha?email=" +
        encodeURIComponent(dados.email) +
        (dados.token ? "&token=" + encodeURIComponent(dados.token) : "");

      ultimoPayloadQrTexto = dados.qrUrl || baseRecuperacao;

      if (msgSemDados) msgSemDados.style.display = "none";
      boxAtivo.style.display = "block";
      mostrarEstadoAguardandoLeitura();
      desenharQrNoCanvas(qrCanvas, ultimoPayloadQrTexto);

      const loginEmailInput = document.getElementById("loginEmail");
      if (loginEmailInput && !loginEmailInput.value) {
        loginEmailInput.value = dados.email;
      }
    }

    configurarCampoTelefone("cad");

    const dadosServidorQr = <%- JSON.stringify(qrObj || null) %>;
    if (dadosServidorQr && dadosServidorQr.email) {
      try {
        localStorage.setItem("alphatv_last_qr_user", JSON.stringify(dadosServidorQr));
      } catch (e) {}
      renderizarDadosQr(dadosServidorQr);
    } else {
      try {
        const salvo = localStorage.getItem("alphatv_last_qr_user");
        if (salvo) {
          const parsed = JSON.parse(salvo);
          if (parsed && parsed.email) {
            renderizarDadosQr(parsed);
          }
        }
      } catch (e) {}
    }
  </script>
</body>
</html>
