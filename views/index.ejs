<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Entrar ou Criar Conta</title>
  <style>
    * { box-sizing: border-box; }

    body {
      background-color: #050811;
      color: #e2e8f0;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 24px;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
    }

    /* === ANIMAÇÃO DE TV AO FUNDO === */
    .tv-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      overflow: hidden;
      background:
        radial-gradient(circle at 50% 35%, rgba(14, 165, 233, 0.14), rgba(5, 8, 17, 0.96) 72%),
        repeating-linear-gradient(
          to bottom,
          rgba(56, 189, 248, 0.04) 0px,
          rgba(56, 189, 248, 0.04) 2px,
          transparent 2px,
          transparent 5px
        );
    }

    .tv-scanline {
      position: absolute;
      left: 0;
      right: 0;
      height: 120px;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        rgba(56, 189, 248, 0.08) 50%,
        transparent 100%
      );
      animation: tvScan 7s linear infinite;
    }

    .tv-pulse-grid {
      position: absolute;
      inset: -20%;
      background-image:
        linear-gradient(to right, rgba(2, 132, 199, 0.07) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(2, 132, 199, 0.07) 1px, transparent 1px);
      background-size: 48px 48px;
      animation: tvDrift 16s ease-in-out infinite alternate;
    }

    .tv-signal-tag {
      position: fixed;
      bottom: 14px;
      right: 18px;
      z-index: 1;
      pointer-events: none;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      color: rgba(56, 189, 248, 0.55);
      display: flex;
      align-items: center;
      gap: 7px;
      text-transform: uppercase;
    }

    .tv-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #38bdf8;
      box-shadow: 0 0 10px #38bdf8;
      animation: tvBlink 1.8s infinite;
    }

    @keyframes tvScan {
      0% { transform: translateY(-160px); }
      100% { transform: translateY(110vh); }
    }

    @keyframes tvDrift {
      0% { transform: translate(0, 0) scale(1); }
      100% { transform: translate(-24px, -18px) scale(1.04); }
    }

    @keyframes tvBlink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.25; }
    }

    .conteudo-principal {
      position: relative;
      z-index: 1;
    }

    .topo {
      max-width: 960px;
      margin: 0 auto 22px auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .marca {
      color: #38bdf8;
      font-size: 1.5rem;
      font-weight: bold;
      text-shadow: 0 0 18px rgba(56, 189, 248, 0.35);
    }

    .grid-acesso {
      max-width: 960px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }

    .card {
      background: rgba(11, 19, 36, 0.92);
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 22px;
      box-shadow: 0 0 26px rgba(0, 180, 255, 0.12);
      backdrop-filter: blur(4px);
    }

    h2 {
      margin: 0 0 14px 0;
      color: #38bdf8;
      font-size: 1.2rem;
    }

    label {
      display: block;
      font-size: 0.85rem;
      color: #94a3b8;
      margin: 10px 0 4px 0;
    }

    input, select {
      width: 100%;
      padding: 10px 12px;
      border-radius: 6px;
      border: 1px solid #334155;
      background: #020617;
      color: #f8fafc;
      font-size: 0.92rem;
    }

    .grupo-telefone {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .prefixo-pais {
      background: #082f49;
      color: #38bdf8;
      border: 1px solid #0284c7;
      border-radius: 6px;
      padding: 10px 10px;
      font-weight: bold;
      font-size: 0.88rem;
      white-space: nowrap;
    }

    .dica-pais {
      font-size: 0.78rem;
      color: #94a3b8;
      margin-top: 4px;
    }

    .btn {
      margin-top: 16px;
      width: 100%;
      background: #0284c7;
      color: #ffffff;
      border: none;
      padding: 11px 14px;
      border-radius: 6px;
      font-size: 0.95rem;
      font-weight: bold;
      cursor: pointer;
    }

    .btn:hover { background: #0ea5e9; }

    .barra-recuperar {
      margin-top: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.88rem;
    }

    .link-recuperar {
      color: #38bdf8;
      text-decoration: underline;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
      font-size: 0.88rem;
      font-weight: bold;
    }

    .painel-recuperacao {
      max-width: 960px;
      margin: 20px auto 0 auto;
      display: none;
    }

    .painel-recuperacao.visivel { display: block; }

    .qr-box {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      align-items: center;
      background: #020617;
      border: 1px solid #1e293b;
      border-radius: 8px;
      padding: 16px;
      margin-top: 12px;
    }

    .qr-canvas-wrap {
      background: #ffffff;
      padding: 12px;
      border-radius: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .qr-meta {
      flex: 1;
      min-width: 240px;
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .alerta-erro {
      max-width: 960px;
      margin: 0 auto 14px auto;
      background: #7f1d1d;
      color: #fecaca;
      border: 1px solid #dc2626;
      padding: 12px 16px;
      border-radius: 8px;
    }
  </style>
</head>
<body>
  <div class="tv-bg" aria-hidden="true">
    <div class="tv-pulse-grid"></div>
    <div class="tv-scanline"></div>
  </div>
  <div class="tv-signal-tag" aria-hidden="true">
    <span class="tv-dot"></span>
    <span>ALPHATV • TV SIGNAL ACTIVE</span>
  </div>

  <div class="conteudo-principal">
    <%
      const qrObj = (typeof qrDados !== "undefined" && qrDados) ? qrDados : null;
      const mostrarQrInicial = Boolean(typeof abrirQrInicial !== "undefined" && abrirQrInicial && qrObj);
    %>

    <div class="topo">
      <div class="marca">AlphaTV</div>
      <div style="font-size: 0.86rem; color: #94a3b8;">7 dias gratuitos • Dados em QR Code no Logout</div>
    </div>

    <% if (typeof erro !== "undefined" && erro) { %>
      <div class="alerta-erro"><%= erro %></div>
    <% } %>

    <div class="grid-acesso">
      <div class="card">
        <h2>Entrar no AlphaTV</h2>
        <form action="/login" method="POST">
          <label for="loginEmail">O teu e-mail</label>
          <input
            type="email"
            id="loginEmail"
            name="email"
            placeholder="O teu e-mail"
            value="<%= qrObj && qrObj.email ? qrObj.email : '' %>"
            required
          />

          <label for="loginPassword">Palavra-passe</label>
          <input
            type="password"
            id="loginPassword"
            name="password"
            placeholder="Palavra-passe"
            required
          />

          <button type="submit" class="btn">Entrar</button>
        </form>

        <div class="barra-recuperar">
          <span style="color:#94a3b8;">Ver dados / QR da conta?</span>
          <button type="button" class="link-recuperar" onclick="alternarRecuperacao(true)">
            Recuperar acesso
          </button>
        </div>
      </div>

      <div class="card">
        <h2>Criar Conta</h2>
        <form action="/cadastrar" method="POST">
          <label for="cadNome">Nome completo</label>
          <input type="text" id="cadNome" name="nome" placeholder="Nome completo" required />

          <label for="cadEmail">E-mail</label>
          <input type="email" id="cadEmail" name="email" placeholder="E-mail" required />

          <label for="cadPassword">Criar palavra-passe</label>
          <input type="password" id="cadPassword" name="password" placeholder="Criar palavra-passe" required />

          <label for="cadPais">País de origem / instalação</label>
          <select id="cadPais" name="pais" onchange="configurarCampoTelefone('cad')">
            <option value="PT">Portugal (+351)</option>
            <option value="BR">Brasil (+55)</option>
            <option value="OUTROS">Outros países (Internacional)</option>
          </select>

          <label for="cadTelefone">Telefone de contacto</label>
          <div class="grupo-telefone">
            <span id="cadPrefixo" class="prefixo-pais">+351</span>
            <input type="text" id="cadTelefone" name="telefone" placeholder="Ex: 912345678" required />
          </div>
          <div id="cadDica" class="dica-pais">Portugal: 9 dígitos (ex: 912345678).</div>

          <label for="cadConvite">Código promocional de convite (opcional)</label>
          <input type="text" id="cadConvite" name="codigoConvite" placeholder="Código de 4 dígitos (se tiver)" />

          <button type="submit" class="btn">Registar e Assistir</button>
        </form>
      </div>
    </div>

    <div id="painelRecuperacao" class="card painel-recuperacao <%= mostrarQrInicial ? 'visivel' : '' %>">
      <div style="display:flex; justify-content:space-between; align-items:center; gap:10px;">
        <h2 style="margin:0;">Recuperar acesso • QR Code da Conta</h2>
        <button type="button" class="link-recuperar" onclick="alternarRecuperacao(false)">Ocultar</button>
      </div>

      <div id="qrConteudoAtivo" class="qr-box" style="<%= qrObj ? '' : 'display:none;' %>">
        <div class="qr-canvas-wrap">
          <canvas id="qrCanvas" width="220" height="220"></canvas>
        </div>
        <div class="qr-meta" id="qrDetalhesLista">
          <div><strong>Recuperação e Nova Senha via QR Code</strong></div>
          <p style="color:#94a3b8; margin:6px 0 0 0;">
            Leia este QR Code com a câmara do telemóvel para abrir a página e criar uma nova senha para a conta.
          </p>
        </div>
      </div>

      <p id="qrSemDadosMsg" style="color:#94a3b8; margin-top:10px; <%= qrObj ? 'display:none;' : '' %>">
        Inicia sessão e faz <strong>Logout</strong> para gerar o <strong>QR Code</strong> com os dados da conta.
      </p>
    </div>
  </div>

  <script>
    let ultimoPayloadQrTexto = "";

    function alternarRecuperacao(mostrar) {
      const painel = document.getElementById("painelRecuperacao");
      if (!painel) return;
      if (mostrar) {
        painel.classList.add("visivel");
        painel.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } else {
        painel.classList.remove("visivel");
      }
    }

    function configurarCampoTelefone(prefixoId) {
      const sel = document.getElementById(prefixoId + "Pais");
      const badge = document.getElementById(prefixoId + "Prefixo");
      const input = document.getElementById(prefixoId + "Telefone");
      const dica = document.getElementById(prefixoId + "Dica");
      if (!sel || !badge || !input) return;

      if (sel.value === "PT") {
        badge.textContent = "+351";
        input.placeholder = "Ex: 912345678";
        if (dica) dica.textContent = "Portugal: 9 dígitos (ex: 912345678).";
      } else if (sel.value === "BR") {
        badge.textContent = "+55";
        input.placeholder = "Ex: 11987654321";
        if (dica) dica.textContent = "Brasil: DDD + número (10 ou 11 dígitos, ex: 11987654321).";
      } else {
        badge.textContent = "INTL";
        input.placeholder = "Ex: +447700900077";
        if (dica) dica.textContent = "Outros países: número completo com código internacional.";
      }
    }

    // Codificador matricial QR Code (Versões 1 a 6, modo Byte UTF-8, nível L)
    const QR_SPECS = [
      null,
      { version: 1, size: 21, dataBytes: 19, eccBytes: 7, align: [] },
      { version: 2, size: 25, dataBytes: 34, eccBytes: 10, align: [18] },
      { version: 3, size: 29, dataBytes: 55, eccBytes: 15, align: [22] },
      { version: 4, size: 33, dataBytes: 80, eccBytes: 20, align: [26] },
      { version: 5, size: 37, dataBytes: 108, eccBytes: 26, align: [30] },
      { version: 6, size: 41, dataBytes: 136, eccBytes: 18, align: [34] },
    ];

    const GF_EXP = new Array(512).fill(0);
    const GF_LOG = new Array(256).fill(0);
    (function initGF() {
      let v = 1;
      for (let i = 0; i < 255; i++) {
        GF_EXP[i] = v;
        GF_LOG[v] = i;
        v <<= 1;
        if (v & 0x100) v ^= 0x11d;
      }
      for (let i = 255; i < 512; i++) {
        GF_EXP[i] = GF_EXP[i - 255];
      }
    })();

    function gfMul(a, b) {
      if (a === 0 || b === 0) return 0;
      return GF_EXP[(GF_LOG[a] + GF_LOG[b]) % 255];
    }

    function calcularEcc(dataBytes, eccLen) {
      let gen = [1];
      for (let i = 0; i < eccLen; i++) {
        const next = new Array(gen.length + 1).fill(0);
        const factor = GF_EXP[i];
        for (let j = 0; j < gen.length; j++) {
          next[j] ^= gen[j];
          next[j + 1] ^= gfMul(gen[j], factor);
        }
        gen = next;
      }

      const msg = dataBytes.concat(new Array(eccLen).fill(0));
      for (let i = 0; i < dataBytes.length; i++) {
        const coef = msg[i];
        if (coef !== 0) {
          for (let j = 1; j < gen.length; j++) {
            msg[i + j] ^= gfMul(gen[j], coef);
          }
        }
      }
      return msg.slice(dataBytes.length);
    }

    function construirMatrizQr(texto) {
      const rawBytes = Array.from(new TextEncoder().encode(String(texto || "")));
      let spec = QR_SPECS.find((s) => s && rawBytes.length <= s.dataBytes - 2);
      let payloadBytes = rawBytes;

      if (!spec) {
        spec = QR_SPECS[6];
        payloadBytes = rawBytes.slice(0, spec.dataBytes - 3);
      }

      const bits = [];
      function pushBits(val, len) {
        for (let i = len - 1; i >= 0; i--) {
          bits.push((val >>> i) & 1);
        }
      }

      pushBits(0b0100, 4);
      pushBits(payloadBytes.length, 8);
      for (const b of payloadBytes) {
        pushBits(b, 8);
      }

      const totalDataBits = spec.dataBytes * 8;
      pushBits(0, Math.min(4, Math.max(0, totalDataBits - bits.length)));
      while (bits.length % 8 !== 0) bits.push(0);

      const pad = [0xec, 0x11];
      let p = 0;
      while (bits.length < totalDataBits) {
        pushBits(pad[p % 2], 8);
        p++;
      }

      const dataCodewords = [];
      for (let i = 0; i < totalDataBits; i += 8) {
        let cw = 0;
        for (let j = 0; j < 8; j++) {
          cw = (cw << 1) | bits[i + j];
        }
        dataCodewords.push(cw);
      }

      const eccCodewords = calcularEcc(dataCodewords, spec.eccBytes);
      const allCodewords = dataCodewords.concat(eccCodewords);

      const size = spec.size;
      const grid = Array.from({ length: size }, () => new Array(size).fill(null));
      const reserved = Array.from({ length: size }, () => new Array(size).fill(false));

      function placeFinder(r0, c0) {
        for (let r = -1; r <= 7; r++) {
          for (let c = -1; c <= 7; c++) {
            const rr = r0 + r;
            const cc = c0 + c;
            if (rr < 0 || rr >= size || cc < 0 || cc >= size) continue;
            const inBox = r >= 0 && r <= 6 && c >= 0 && c <= 6;
            const onBorder = r === 0 || r === 6 || c === 0 || c === 6;
            const inCenter = r >= 2 && r <= 4 && c >= 2 && c <= 4;
            grid[rr][cc] = inBox ? (onBorder || inCenter ? 1 : 0) : 0;
            reserved[rr][cc] = true;
          }
        }
      }

      placeFinder(0, 0);
      placeFinder(0, size - 7);
      placeFinder(size - 7, 0);

      for (const center of spec.align) {
        for (let r = -2; r <= 2; r++) {
          for (let c = -2; c <= 2; c++) {
            const rr = center + r;
            const cc = center + c;
            if (reserved[rr][cc]) continue;
            const dist = Math.max(Math.abs(r), Math.abs(c));
            grid[rr][cc] = dist === 0 || dist === 2 ? 1 : 0;
            reserved[rr][cc] = true;
          }
        }
      }

      for (let i = 8; i < size - 8; i++) {
        const val = i % 2 === 0 ? 1 : 0;
        if (!reserved[6][i]) {
          grid[6][i] = val;
          reserved[6][i] = true;
        }
        if (!reserved[i][6]) {
          grid[i][6] = val;
          reserved[i][6] = true;
        }
      }

      grid[size - 8][8] = 1;
      reserved[size - 8][8] = true;

      for (let i = 0; i < 9; i++) {
        reserved[8][i] = true;
        reserved[i][8] = true;
      }
      for (let i = 0; i < 8; i++) {
        reserved[8][size - 1 - i] = true;
        reserved[size - 1 - i][8] = true;
      }

      const bitStream = [];
      for (const cw of allCodewords) {
        for (let j = 7; j >= 0; j--) {
          bitStream.push((cw >>> j) & 1);
        }
      }

      let ptr = 0;
      let goingUp = true;
      for (let col = size - 1; col >= 1; col -= 2) {
        if (col === 6) col = 5;
        for (let step = 0; step < size; step++) {
          const row = goingUp ? size - 1 - step : step;
          for (const c of [col, col - 1]) {
            if (!reserved[row][c]) {
              const b = ptr < bitStream.length ? bitStream[ptr++] : 0;
              grid[row][c] = ((row + c) % 2 === 0) ? (b ^ 1) : b;
            }
          }
        }
        goingUp = !goingUp;
      }

      const formatBits = [1, 1, 1, 0, 1, 1, 1, 1, 1, 0, 0, 0, 1, 0, 0];
      const topLeft = [
        [0, 8], [1, 8], [2, 8], [3, 8], [4, 8], [5, 8], [7, 8], [8, 8],
        [8, 7], [8, 5], [8, 4], [8, 3], [8, 2], [8, 1], [8, 0]
      ];
      for (let i = 0; i < 15; i++) {
        const [r, c] = topLeft[i];
        grid[r][c] = formatBits[i];
      }
      for (let i = 0; i < 8; i++) {
        grid[size - 1 - i][8] = formatBits[i];
      }
      for (let i = 0; i < 7; i++) {
        grid[8][size - 7 + i] = formatBits[8 + i];
      }

      return grid;
    }

    function desenharQrNoCanvas(canvas, texto) {
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      if (!texto) return;

      try {
        const grid = construirMatrizQr(texto);
        const quiet = 2;
        const total = grid.length + quiet * 2;
        const cell = Math.max(2, Math.floor(canvas.width / total));
        const used = cell * total;
        const ox = Math.floor((canvas.width - used) / 2);
        const oy = Math.floor((canvas.height - used) / 2);

        for (let r = 0; r < grid.length; r++) {
          for (let c = 0; c < grid.length; c++) {
            if (grid[r][c] === 1) {
              ctx.fillStyle = "#000000";
              ctx.fillRect(ox + (c + quiet) * cell, oy + (r + quiet) * cell, cell, cell);
            }
          }
        }
      } catch (err) {
        console.error("Erro ao desenhar matriz QR:", err);
      }
    }

    function renderizarDadosQr(dados) {
      const boxAtivo = document.getElementById("qrConteudoAtivo");
      const msgSemDados = document.getElementById("qrSemDadosMsg");
      const qrCanvas = document.getElementById("qrCanvas");
      if (!boxAtivo || !qrCanvas || !dados || !dados.email) return;

      const urlRecuperacao =
        dados.qrUrl ||
        (window.location.origin + "/recuperar-senha?email=" + encodeURIComponent(dados.email));

      ultimoPayloadQrTexto = urlRecuperacao;

      if (msgSemDados) msgSemDados.style.display = "none";
      boxAtivo.style.display = "flex";
      desenharQrNoCanvas(qrCanvas, ultimoPayloadQrTexto);

      const loginEmailInput = document.getElementById("loginEmail");
      if (loginEmailInput && !loginEmailInput.value) {
        loginEmailInput.value = dados.email;
      }
    }

    configurarCampoTelefone("cad");

    const dadosServidorQr = <%- JSON.stringify(qrObj || null) %>;
    if (dadosServidorQr && dadosServidorQr.email) {
      try {
        localStorage.setItem("alphatv_last_qr_user", JSON.stringify(dadosServidorQr));
      } catch (e) {}
      renderizarDadosQr(dadosServidorQr);
    } else {
      try {
        const salvo = localStorage.getItem("alphatv_last_qr_user");
        if (salvo) {
          const parsed = JSON.parse(salvo);
          if (parsed && parsed.email) {
            renderizarDadosQr(parsed);
          }
        }
      } catch (e) {}
    }
  </script>
</body>
</html>