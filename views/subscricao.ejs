<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Planos e Pagamento</title>
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      background: #050811;
      color: #e2e8f0;
      font-family: Arial, Helvetica, sans-serif;
    }

    .topbar {
      background: rgba(8, 14, 28, 0.96);
      border-bottom: 1px solid #1e293b;
      padding: 12px 20px;
    }

    .topbar-inner {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .brand {
      color: #38bdf8;
      font-size: 1.3rem;
      font-weight: 800;
      text-decoration: none;
    }

    .btn {
      background: #0284c7;
      color: #ffffff;
      border: none;
      border-radius: 7px;
      padding: 9px 14px;
      font-size: 0.86rem;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .btn:hover { background: #0ea5e9; }

    .btn-ghost {
      background: #0b1324;
      color: #38bdf8;
      border: 1px solid #1e293b;
    }

    .btn-danger {
      background: #7f1d1d;
      color: #fecaca;
      padding: 6px 10px;
      font-size: 0.8rem;
    }

    .btn-danger:hover {
      background: #991b1b;
      color: #ffffff;
    }

    .container {
      max-width: 1240px;
      margin: 20px auto 36px auto;
      padding: 0 20px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .card {
      background: #0b1324;
      border: 1px solid #1e293b;
      border-radius: 12px;
      padding: 20px;
    }

    .card-title {
      margin: 0 0 14px 0;
      color: #38bdf8;
      font-size: 1.12rem;
    }

    .planos-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-bottom: 18px;
    }

    .plano-card {
      background: #060b16;
      border: 2px solid #1e293b;
      border-radius: 10px;
      padding: 14px;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 6px;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .plano-card:has(input:checked) {
      border-color: #38bdf8;
      background: #082f49;
    }

    .plano-nome {
      font-size: 0.88rem;
      color: #cbd5e1;
      font-weight: 700;
    }

    .plano-preco {
      font-size: 1.35rem;
      font-weight: 800;
      color: #38bdf8;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 14px;
      margin-bottom: 16px;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 0.84rem;
      color: #94a3b8;
    }

    input, select {
      background: #020617;
      color: #f8fafc;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 0.9rem;
    }

    input:focus, select:focus {
      outline: none;
      border-color: #38bdf8;
    }

    .resumo-pagamento {
      background: #060b16;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 14px 16px;
      margin-bottom: 16px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
    }

    .resumo-item span {
      display: block;
      font-size: 0.76rem;
      color: #94a3b8;
      text-transform: uppercase;
    }

    .resumo-item strong {
      font-size: 1.05rem;
      color: #38bdf8;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.86rem;
    }

    th, td {
      padding: 10px 12px;
      border-bottom: 1px solid #1e293b;
      text-align: left;
    }

    th {
      color: #94a3b8;
      font-size: 0.76rem;
      text-transform: uppercase;
    }

    .alert-erro {
      background: rgba(127, 29, 29, 0.45);
      border: 1px solid #dc2626;
      color: #fecaca;
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 0.86rem;
    }
  </style>
</head>
<body>
  <%
    const planosSafe = (typeof planos !== "undefined" && Array.isArray(planos)) ? planos : [];
    const metodosSafe = (typeof metodos !== "undefined" && Array.isArray(metodos)) ? metodos : [];
    const moedasSafe = (typeof moedasWise !== "undefined" && Array.isArray(moedasWise)) ? moedasWise : [
      { codigo: "EUR", nome: "Euro (EUR)", simbolo: "€" },
      { codigo: "USD", nome: "Dólar Americano (USD)", simbolo: "$" },
      { codigo: "BRL", nome: "Real Brasileiro (BRL)", simbolo: "R$" }
    ];
    const pendentesSafe = (typeof comprasPendentes !== "undefined" && Array.isArray(comprasPendentes)) ? comprasPendentes : [];
    const confirmadosSafe = (typeof historicoCompras !== "undefined" && Array.isArray(historicoCompras)) ? historicoCompras : [];
    const cfg = (typeof configAdmin !== "undefined" && configAdmin) ? configAdmin : { entidade: "21478" };
  %>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/player" class="brand">AlphaTV • Planos e Subscrição</a>
      <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <% if (typeof utilizador !== "undefined" && utilizador && String(utilizador.role || "").toLowerCase() === "administrador") { %>
          <a href="/admin" class="btn btn-ghost">Voltar ao Admin</a>
        <% } %>
        <a href="/player" class="btn">Voltar ao Player</a>
      </div>
    </div>
  </header>

  <main class="container">
    <% if (typeof erro !== "undefined" && erro) { %>
      <div class="alert-erro"><%= erro %></div>
    <% } %>

    <!-- ESCOLHA DE PLANO, MOEDA WISE, MÉTODO E CÓDIGO PROMOCIONAL -->
    <section class="card">
      <h1 class="card-title">Escolha o seu Plano (30, 60, 90, 180, 270 ou 360 Dias)</h1>

      <form action="/subscricao/iniciar" method="POST">
        <div class="planos-grid">
          <% planosSafe.forEach(function(p, index) { %>
            <label class="plano-card">
              <input
                type="radio"
                name="planoDias"
                value="<%= p.dias %>"
                data-preco="<%= p.valorBase %>"
                <%= index === 0 ? "checked" : "" %>
                onchange="recalcularValores()"
              />
              <span class="plano-nome"><%= p.nome %></span>
              <span class="plano-preco"><%= Number(p.valorBase).toFixed(2) %> €</span>
            </label>
          <% }); %>
        </div>

        <div class="form-grid">
          <label>
            Método de Pagamento
            <select id="metodoPagamento" name="metodoPagamento" onchange="atualizarDetalhesMetodo()">
              <% metodosSafe.forEach(function(m) { %>
                <option
                  value="<%= m.id %>"
                  data-entidade="<%= m.entidade || cfg.entidade || '21478' %>"
                  data-conta="<%= m.contaDestino || '' %>"
                  data-detalhe="<%= m.detalhe || '' %>"
                >
                  <%= m.nome %>
                </option>
              <% }); %>
            </select>
          </label>

          <label>
            Moeda Preferida (Taxas Wise do Dia Anterior)
            <select id="moedaPreferida" name="moedaPreferida" onchange="recalcularValores()">
              <% moedasSafe.forEach(function(mo) { %>
                <option value="<%= mo.codigo %>"><%= mo.nome %></option>
              <% }); %>
            </select>
          </label>

          <label>
            Código Promocional de Convite (opcional • 10% desc.)
            <input
              type="text"
              id="codigoPromocional"
              name="codigoPromocional"
              placeholder="Ex: 8261"
              oninput="recalcularValores()"
            />
          </label>
        </div>

        <input type="hidden" id="taxaCambioOntemInput" name="taxaCambioOntem" value="1" />
        <input type="hidden" id="dataCambioOntemInput" name="dataCambioOntem" value="" />

        <div class="resumo-pagamento">
          <div class="resumo-item">
            <span>Entidade / Dados do Método</span>
            <strong id="resumoEntidade"><%= cfg.entidade || "21478" %></strong>
            <div id="resumoContaMetodo" style="font-size:0.78rem; color:#94a3b8; margin-top:2px;"></div>
          </div>

          <div class="resumo-item">
            <span>Desconto Aplicado</span>
            <strong id="resumoDesconto">0.00 EUR</strong>
          </div>

          <div class="resumo-item">
            <span>Total Final (EUR)</span>
            <strong id="resumoTotalEur">9.99 EUR</strong>
          </div>

          <div class="resumo-item">
            <span>Total na Moeda Preferida (Câmbio de Ontem)</span>
            <strong id="resumoTotalMoeda">9.99 EUR</strong>
            <div id="resumoDataCambio" style="font-size:0.76rem; color:#94a3b8; margin-top:2px;"></div>
          </div>
        </div>

        <button type="submit" class="btn">Gerar Entidade e Referência de Pagamento</button>
      </form>
    </section>

    <!-- PAGAMENTOS PENDENTES DE CONFIRMAÇÃO (COM BOTÃO APAGAR) -->
    <section class="card">
      <h2 class="card-title">Pagamentos Pendentes de Confirmação</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Código</th>
              <th>Plano</th>
              <th>Método</th>
              <th>Entidade</th>
              <th>Referência</th>
              <th>Valor</th>
              <th>Estado</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody>
            <% if (pendentesSafe.length === 0) { %>
              <tr>
                <td colspan="8" style="color:#94a3b8;">Nenhum pagamento pendente de confirmação.</td>
              </tr>
            <% } else { %>
              <% pendentesSafe.forEach(function(item) { %>
                <tr>
                  <td><strong><%= item.codigoRecibo %></strong></td>
                  <td><%= item.nomePlano %></td>
                  <td><%= item.metodoPagamento %></td>
                  <td><strong><%= item.entidadePagamento || cfg.entidade || "21478" %></strong></td>
                  <td><strong><%= item.referenciaPagamento %></strong></td>
                  <td>
                    <div><%= Number(item.valorFinal).toFixed(2) %> EUR</div>
                    <% if (item.moedaConvertida && item.moedaConvertida !== "EUR") { %>
                      <div style="font-size:0.78rem; color:#38bdf8;">
                        ≈ <%= Number(item.valorConvertido).toFixed(2) %> <%= item.moedaConvertida %>
                      </div>
                    <% } %>
                  </td>
                  <td style="color:#fbbf24; font-weight:700;">Aguarda confirmação do Admin</td>
                  <td>
                    <form action="/pagamento/<%= encodeURIComponent(item.codigoRecibo) %>/apagar" method="POST" onsubmit="return confirm('Apagar este pagamento pendente?');" style="margin:0;">
                      <button type="submit" class="btn btn-danger">Apagar</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <!-- HISTÓRICO DE COMPRAS E RECIBOS CONFIRMADOS PELO ADMIN -->
    <section class="card">
      <h2 class="card-title">Histórico de Compras e Recibos Confirmados</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Recibo</th>
              <th>Plano</th>
              <th>Método / Entidade</th>
              <th>Valor Pago</th>
              <th>Válido Até</th>
              <th>Fatura</th>
            </tr>
          </thead>
          <tbody>
            <% if (confirmadosSafe.length === 0) { %>
              <tr>
                <td colspan="6" style="color:#94a3b8;">Ainda não existem pagamentos confirmados pelo administrador.</td>
              </tr>
            <% } else { %>
              <% confirmadosSafe.forEach(function(item) { %>
                <tr>
                  <td><strong><%= item.codigoRecibo %></strong></td>
                  <td><%= item.nomePlano %></td>
                  <td><%= item.metodoPagamento %> (Ent: <%= item.entidadePagamento || cfg.entidade || "21478" %>)</td>
                  <td><%= Number(item.valorFinal).toFixed(2) %> EUR</td>
                  <td><%= item.validoAte ? new Date(item.validoAte).toLocaleDateString("pt-PT") : "-" %></td>
                  <td>
                    <a href="/recibo/<%= encodeURIComponent(item.codigoRecibo) %>" class="btn">Ver Recibo</a>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <script>
    let taxasCambioOntem = { EUR: 1, USD: 1.08, BRL: 6.15, GBP: 0.84, CHF: 0.94 };
    let dataCambioRef = "";

    async function carregarTaxasOntem() {
      try {
        const resp = await fetch("/api/cambio-ontem");
        if (resp.ok) {
          const data = await resp.json();
          if (data && data.taxas) {
            taxasCambioOntem = data.taxas;
          }
          dataCambioRef = data.dataReferencia || "";
        }
      } catch (e) {}
      recalcularValores();
    }

    function atualizarDetalhesMetodo() {
      const sel = document.getElementById("metodoPagamento");
      const entEl = document.getElementById("resumoEntidade");
      const contaEl = document.getElementById("resumoContaMetodo");
      if (!sel || !entEl) return;

      const opt = sel.options[sel.selectedIndex];
      const entidade = opt ? (opt.dataset.entidade || "21478") : "21478";
      const conta = opt ? (opt.dataset.conta || "") : "";
      const detalhe = opt ? (opt.dataset.detalhe || "") : "";

      entEl.textContent = "Entidade: " + entidade;
      if (contaEl) {
        contaEl.textContent = conta ? ("Conta/Chave: " + conta) : detalhe;
      }
    }

    function recalcularValores() {
      const radioPlano = document.querySelector('input[name="planoDias"]:checked');
      const precoBase = parseFloat(radioPlano ? radioPlano.dataset.preco : "9.99") || 9.99;

      const codigo = (document.getElementById("codigoPromocional")?.value || "").trim();
      const temDesconto = codigo.length > 0;
      const desconto = temDesconto ? Number((precoBase * 0.1).toFixed(2)) : 0;
      const totalEur = Number(Math.max(0.5, precoBase - desconto).toFixed(2));

      const moeda = document.getElementById("moedaPreferida")?.value || "EUR";
      const taxa = Number(taxasCambioOntem[moeda]) || 1;
      const totalMoeda = Number((totalEur * taxa).toFixed(2));

      const elDesc = document.getElementById("resumoDesconto");
      const elEur = document.getElementById("resumoTotalEur");
      const elMoeda = document.getElementById("resumoTotalMoeda");
      const elData = document.getElementById("resumoDataCambio");

      if (elDesc) elDesc.textContent = desconto.toFixed(2) + " EUR" + (temDesconto ? " (10%)" : "");
      if (elEur) elEur.textContent = totalEur.toFixed(2) + " EUR";
      if (elMoeda) elMoeda.textContent = totalMoeda.toFixed(2) + " " + moeda;
      if (elData) {
        elData.textContent = dataCambioRef
          ? ("Taxa de " + dataCambioRef + ": 1 EUR = " + taxa + " " + moeda)
          : ("Taxa do dia anterior: 1 EUR = " + taxa + " " + moeda);
      }

      const taxaInput = document.getElementById("taxaCambioOntemInput");
      const dataInput = document.getElementById("dataCambioOntemInput");
      if (taxaInput) taxaInput.value = String(taxa);
      if (dataInput) dataInput.value = dataCambioRef;
    }

    window.addEventListener("DOMContentLoaded", function () {
      atualizarDetalhesMetodo();
      carregarTaxasOntem();
    });
  </script>
</body>
</html>