<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Planos, Confirmação e Histórico</title>
  <style>
    body { background: #050811; color: #e2e8f0; font-family: Arial, sans-serif; margin: 0; }
    header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; background: #0b1324; border-bottom: 1px solid #1e293b; padding: 14px 24px; }
    .marca { color: #38bdf8; font-size: 1.25rem; font-weight: bold; }
    .btn, a.btn { background: #0284c7; color: #fff; text-decoration: none; border: none; padding: 9px 14px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 0.88rem; }
    .btn:hover, a.btn:hover { background: #0ea5e9; }
    .btn-sair { background: #7f1d1d; }
    main { max-width: 1120px; margin: 28px auto; padding: 0 20px; display: grid; gap: 22px; }
    .card { background: #0b1324; border: 1px solid #1e293b; border-radius: 10px; padding: 22px; }
    h1, h2 { margin-top: 0; color: #38bdf8; }
    .grid-planos { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin: 16px 0; }
    .plano-item { background: #020617; border: 1px solid #334155; border-radius: 8px; padding: 14px; cursor: pointer; display: block; }
    .plano-item:has(input:checked) { border-color: #38bdf8; }
    .preco { color: #38bdf8; font-size: 1.35rem; font-weight: bold; margin: 6px 0; }
    .form-pagamento { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-top: 14px; }
    label { display: block; font-size: 0.85rem; color: #94a3b8; margin-bottom: 6px; }
    select, input[type="text"] { width: 100%; box-sizing: border-box; padding: 10px; border-radius: 6px; border: 1px solid #334155; background: #020617; color: #f8fafc; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #1e293b; font-size: 0.88rem; }
    th { color: #94a3b8; }
  </style>
</head>
<body>
  <header>
    <div class="marca">AlphaTV • Planos e Pagamentos</div>
    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
      <span><strong><%= utilizador.nome %></strong></span>
      <a href="/player" class="btn">Voltar ao Player</a>
      <a href="/logout" class="btn btn-sair">Sair</a>
    </div>
  </header>

  <main>
    <div class="card">
      <h1>Planos de 30, 60, 90 e 180 Dias</h1>
      <p style="color:#94a3b8;">Gere a referência do método de pagamento e confirme o pagamento para liberar o acesso.</p>

      <form action="/subscricao/pagar" method="POST">
        <div class="grid-planos">
          <% planos.forEach(function(p, idx) { %>
            <label class="plano-item">
              <input type="radio" name="planoDias" value="<%= p.dias %>" <%= idx === 0 ? "checked" : "" %> />
              <div style="color:#38bdf8; font-size:0.8rem;"><%= p.etiqueta %></div>
              <div style="margin-top:6px;"><strong><%= p.nome %></strong></div>
              <div class="preco"><%= p.valorBase.toFixed(2) %> €</div>
            </label>
          <% }); %>
        </div>

        <div class="form-pagamento">
          <div>
            <label for="metodoPagamento">Método de Pagamento</label>
            <select id="metodoPagamento" name="metodoPagamento" required>
              <% metodos.forEach(function(m) { %>
                <option value="<%= m.id %>"><%= m.nome %></option>
              <% }); %>
            </select>
          </div>
          <div>
            <label for="codigoPromocional">Código Promocional de Convite (opcional • 10% desc.)</label>
            <input type="text" id="codigoPromocional" name="codigoPromocional" placeholder="Ex: ALPHATV-JOAO-9F2A" />
          </div>
        </div>

        <div style="margin-top:18px;">
          <button type="submit" class="btn">Gerar Referência de Pagamento</button>
        </div>
      </form>
    </div>

    <% if (comprasPendentes && comprasPendentes.length > 0) { %>
      <div class="card">
        <h2>Pagamentos Pendentes de Confirmação</h2>
        <div style="overflow-x:auto;">
          <table>
            <thead>
              <tr>
                <th>Código</th>
                <th>Plano</th>
                <th>Método</th>
                <th>Referência</th>
                <th>Valor</th>
                <th>Confirmação</th>
              </tr>
            </thead>
            <tbody>
              <% comprasPendentes.forEach(function(cp) { %>
                <tr>
                  <td><strong><%= cp.codigoRecibo %></strong></td>
                  <td><%= cp.nomePlano %></td>
                  <td><%= cp.metodoPagamento %></td>
                  <td><%= cp.referenciaPagamento %></td>
                  <td><%= Number(cp.valorFinal).toFixed(2) %> <%= cp.moeda || "EUR" %></td>
                  <td>
                    <form action="/subscricao/confirmar/<%= encodeURIComponent(cp.codigoRecibo) %>" method="POST" style="margin:0;">
                      <button type="submit" class="btn">Confirmar Pagamento e Liberar</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <div class="card">
      <h2>Histórico de Compras e Recibos Confirmados</h2>
      <% if (!historicoCompras || historicoCompras.length === 0) { %>
        <p style="color:#94a3b8;">Ainda não existem pagamentos confirmados.</p>
      <% } else { %>
        <div style="overflow-x:auto;">
          <table>
            <thead>
              <tr>
                <th>Recibo</th>
                <th>Plano</th>
                <th>Método</th>
                <th>Total</th>
                <th>Válido Até</th>
                <th>Recibo</th>
              </tr>
            </thead>
            <tbody>
              <% historicoCompras.forEach(function(c) { %>
                <tr>
                  <td><strong><%= c.codigoRecibo %></strong></td>
                  <td><%= c.nomePlano %></td>
                  <td><%= c.metodoPagamento %></td>
                  <td><%= Number(c.valorFinal).toFixed(2) %> <%= c.moeda || "EUR" %></td>
                  <td><%= new Date(c.validoAte).toLocaleDateString("pt-PT") %></td>
                  <td><a href="/recibo/<%= encodeURIComponent(c.codigoRecibo) %>" class="btn">Ver Recibo</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>