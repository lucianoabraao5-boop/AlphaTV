<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Entrar ou Criar Conta</title>
  <style>
    body {
      background-color: #050811;
      color: #e2e8f0;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 24px;
    }
    .topo {
      max-width: 1120px;
      margin: 0 auto 22px auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    .marca {
      color: #38bdf8;
      font-size: 1.4rem;
      font-weight: bold;
    }
    .grid-acesso {
      max-width: 1120px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
      gap: 20px;
    }
    .card {
      background: #0b1324;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 22px;
      box-shadow: 0 0 24px rgba(0, 180, 255, 0.1);
    }
    h2 {
      margin: 0 0 14px 0;
      color: #38bdf8;
      font-size: 1.2rem;
    }
    label {
      display: block;
      font-size: 0.85rem;
      color: #94a3b8;
      margin: 10px 0 4px 0;
    }
    input, select {
      width: 100%;
      box-sizing: border-box;
      padding: 10px 12px;
      border-radius: 6px;
      border: 1px solid #334155;
      background: #020617;
      color: #f8fafc;
      font-size: 0.92rem;
    }
    .grupo-telefone {
      display: flex;
      gap: 8px;
      align-items: center;
    }
    .prefixo-pais {
      background: #082f49;
      color: #38bdf8;
      border: 1px solid #0284c7;
      border-radius: 6px;
      padding: 10px 10px;
      font-weight: bold;
      font-size: 0.88rem;
      white-space: nowrap;
    }
    .dica-pais {
      font-size: 0.78rem;
      color: #94a3b8;
      margin-top: 4px;
    }
    .btn {
      margin-top: 16px;
      width: 100%;
      background: #0284c7;
      color: #ffffff;
      border: none;
      padding: 11px 14px;
      border-radius: 6px;
      font-size: 0.95rem;
      font-weight: bold;
      cursor: pointer;
    }
    .btn:hover {
      background: #0ea5e9;
    }
    .alerta-erro {
      max-width: 1120px;
      margin: 0 auto 14px auto;
      background: #7f1d1d;
      color: #fecaca;
      border: 1px solid #dc2626;
      padding: 12px 16px;
      border-radius: 8px;
    }
    .alerta-sucesso {
      max-width: 1120px;
      margin: 0 auto 14px auto;
      background: #082f49;
      color: #bae6fd;
      border: 1px solid #0284c7;
      padding: 12px 16px;
      border-radius: 8px;
    }
  </style>
</head>
<body>
  <%
    const recDados = typeof dadosRecuperacao !== "undefined" && dadosRecuperacao
      ? dadosRecuperacao
      : { pais: "PT", telefone: "", email: "" };
    const passoAtual = typeof passoRecuperacao !== "undefined" ? passoRecuperacao : "solicitar";
  %>

  <div class="topo">
    <div class="marca">AlphaTV</div>
    <div style="font-size: 0.86rem; color: #94a3b8;">7 dias gratuitos • Suporte por telefone conforme o país</div>
  </div>

  <% if (typeof erro !== "undefined" && erro) { %>
    <div class="alerta-erro"><%= erro %></div>
  <% } %>

  <% if (typeof sucesso !== "undefined" && sucesso) { %>
    <div class="alerta-sucesso">
      <div><%= sucesso %></div>
      <% if (typeof codigoDemo !== "undefined" && codigoDemo) { %>
        <div style="margin-top: 6px;">Código de confirmação (teste local): <strong><%= codigoDemo %></strong></div>
      <% } %>
    </div>
  <% } %>

  <div class="grid-acesso">
    <!-- ENTRAR -->
    <div class="card">
      <h2>Entrar no AlphaTV</h2>
      <form action="/login" method="POST">
        <label for="loginEmail">O teu e-mail</label>
        <input
          type="email"
          id="loginEmail"
          name="email"
          placeholder="O teu e-mail"
          value="<%= recDados.email || '' %>"
          required
        />

        <label for="loginPassword">Palavra-passe</label>
        <input
          type="password"
          id="loginPassword"
          name="password"
          placeholder="Palavra-passe"
          required
        />

        <button type="submit" class="btn">Entrar</button>
      </form>
    </div>

    <!-- CRIAR CONTA COM PAÍS E TELEFONE -->
    <div class="card">
      <h2>Criar Conta</h2>
      <form action="/cadastrar" method="POST">
        <label for="cadNome">Nome completo</label>
        <input type="text" id="cadNome" name="nome" placeholder="Nome completo" required />

        <label for="cadEmail">E-mail</label>
        <input type="email" id="cadEmail" name="email" placeholder="E-mail" required />

        <label for="cadPassword">Criar palavra-passe</label>
        <input type="password" id="cadPassword" name="password" placeholder="Criar palavra-passe" required />

        <label for="cadPais">País de origem / instalação</label>
        <select id="cadPais" name="pais" onchange="configurarCampoTelefone('cad')">
          <option value="PT">Portugal (+351)</option>
          <option value="BR">Brasil (+55)</option>
          <option value="OUTROS">Outros países (Internacional)</option>
        </select>

        <label for="cadTelefone">Telefone (para recuperação por mensagem)</label>
        <div class="grupo-telefone">
          <span id="cadPrefixo" class="prefixo-pais">+351</span>
          <input
            type="text"
            id="cadTelefone"
            name="telefone"
            placeholder="Ex: 912345678"
            required
          />
        </div>
        <div id="cadDica" class="dica-pais">Portugal: 9 dígitos (ex: 912345678).</div>

        <label for="cadConvite">Código promocional de convite (opcional)</label>
        <input type="text" id="cadConvite" name="codigoConvite" placeholder="Código promocional (se tiver)" />

        <button type="submit" class="btn">Registar e Assistir</button>
      </form>
    </div>

    <!-- RECUPERAÇÃO DE SENHA / ACESSO POR TELEFONE SEGUNDO O PAÍS -->
    <div class="card">
      <h2>Recuperar Acesso por Telefone</h2>
      <% if (passoAtual !== "confirmar") { %>
        <form action="/recuperar/enviar-codigo" method="POST">
          <label for="recPais">País de origem / instalação</label>
          <select id="recPais" name="pais" onchange="configurarCampoTelefone('rec')">
            <option value="PT" <%= recDados.pais === "PT" ? "selected" : "" %>>Portugal (+351)</option>
            <option value="BR" <%= recDados.pais === "BR" ? "selected" : "" %>>Brasil (+55)</option>
            <option value="OUTROS" <%= recDados.pais === "OUTROS" ? "selected" : "" %>>Outros países</option>
          </select>

          <label for="recTelefone">Número de telefone registado</label>
          <div class="grupo-telefone">
            <span id="recPrefixo" class="prefixo-pais">+351</span>
            <input
              type="text"
              id="recTelefone"
              name="telefone"
              value="<%= recDados.telefone || '' %>"
              placeholder="Ex: 912345678"
              required
            />
          </div>
          <div id="recDica" class="dica-pais">Enviaremos o código de confirmação conforme o país selecionado.</div>

          <label for="recEmail">E-mail da conta (opcional)</label>
          <input
            type="email"
            id="recEmail"
            name="email"
            value="<%= recDados.email || '' %>"
            placeholder="Opcional"
          />

          <button type="submit" class="btn">Enviar Mensagem de Confirmação</button>
        </form>
      <% } else { %>
        <form action="/recuperar/confirmar" method="POST">
          <label for="confTelefone">Telefone confirmado</label>
          <input type="text" id="confTelefone" name="telefone" value="<%= recDados.telefone || '' %>" readonly />

          <label for="confCodigo">Código recebido por mensagem</label>
          <input type="text" id="confCodigo" name="codigo" placeholder="Código de 6 dígitos" required />

          <label for="confNovaSenha">Nova palavra-passe</label>
          <input type="password" id="confNovaSenha" name="novaSenha" placeholder="Nova palavra-passe" required />

          <button type="submit" class="btn">Confirmar Código e Redefinir</button>
        </form>
      <% } %>
    </div>
  </div>

  <script>
    function configurarCampoTelefone(prefixoId) {
      const sel = document.getElementById(prefixoId + "Pais");
      const badge = document.getElementById(prefixoId + "Prefixo");
      const input = document.getElementById(prefixoId + "Telefone");
      const dica = document.getElementById(prefixoId + "Dica");
      if (!sel || !badge || !input) return;

      if (sel.value === "PT") {
        badge.textContent = "+351";
        input.placeholder = "Ex: 912345678";
        if (dica) dica.textContent = "Portugal: 9 dígitos (ex: 912345678).";
      } else if (sel.value === "BR") {
        badge.textContent = "+55";
        input.placeholder = "Ex: 11987654321";
        if (dica) dica.textContent = "Brasil: DDD + número (10 ou 11 dígitos, ex: 11987654321).";
      } else {
        badge.textContent = "INTL";
        input.placeholder = "Ex: +447700900077";
        if (dica) dica.textContent = "Outros países: número completo com código internacional.";
      }
    }

    configurarCampoTelefone("cad");
    configurarCampoTelefone("rec");
  </script>
</body>
</html>