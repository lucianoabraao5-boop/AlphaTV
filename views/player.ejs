<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Área do Utilizador</title>
  <style>
    body {
      background-color: #070b14;
      color: #e2e8f0;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      background: #0f172a;
      border-bottom: 1px solid #1e293b;
      padding: 14px 24px;
    }
    .marca {
      color: #38bdf8;
      font-size: 1.25rem;
      font-weight: bold;
    }
    .acoes {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .badge {
      background: #082f49;
      color: #38bdf8;
      border: 1px solid #0284c7;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.85rem;
    }
    .btn, a.btn {
      background: #0284c7;
      color: #ffffff;
      text-decoration: none;
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 0.9rem;
      cursor: pointer;
    }
    .btn:hover, a.btn:hover {
      background: #0ea5e9;
    }
    .btn-sair {
      background: #7f1d1d;
    }
    .btn-sair:hover {
      background: #991b1b;
    }
    main {
      max-width: 1100px;
      margin: 28px auto;
      padding: 0 20px;
    }
    .player-box {
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 20px;
      box-shadow: 0 0 24px rgba(0, 180, 255, 0.12);
    }
    video {
      width: 100%;
      max-height: 520px;
      border-radius: 8px;
      background: #000000;
    }
    .barra-stream {
      display: flex;
      gap: 10px;
      margin-top: 14px;
      flex-wrap: wrap;
    }
    .barra-stream input {
      flex: 1;
      min-width: 240px;
      padding: 10px;
      border-radius: 6px;
      border: 1px solid #334155;
      background: #020617;
      color: #f8fafc;
    }
  </style>
</head>
<body>
  <header>
    <div class="marca">AlphaTV</div>
    <div class="acoes">
      <span>Olá, <strong><%= utilizador.nome %></strong></span>
      <span class="badge"><%= utilizador.role %></span>
      <% if (utilizador.role === "Administrador") { %>
        <a href="/admin" class="btn">Painel Admin</a>
      <% } %>
      <a href="/logout" class="btn btn-sair">Sair</a>
    </div>
  </header>

  <main>
    <div class="player-box">
      <h2 style="margin-top: 0; color: #38bdf8;">Conteúdo Interno</h2>
      <video id="videoPlayer" controls playsinline></video>

      <div class="barra-stream">
        <input
          type="text"
          id="streamUrl"
          placeholder="Cola aqui um link de vídeo (.mp4 ou .m3u8) para testar..."
        />
        <button class="btn" onclick="carregarStream()">Reproduzir</button>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
  <script>
    function carregarStream() {
      const url = document.getElementById("streamUrl").value.trim();
      const video = document.getElementById("videoPlayer");
      if (!url) return;

      if (url.includes(".m3u8") && window.Hls && Hls.isSupported()) {
        const hls = new Hls();
        hls.loadSource(url);
        hls.attachMedia(video);
        hls.on(Hls.Events.MANIFEST_PARSED, () => video.play());
      } else {
        video.src = url;
        video.play();
      }
    }
  </script>
</body>
</html>