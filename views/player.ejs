<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AlphaTV | Área do Utilizador</title>
  <style>
    body {
      background-color: #070b14;
      color: #e2e8f0;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
    }
    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      background: #0f172a;
      border-bottom: 1px solid #1e293b;
      padding: 14px 24px;
    }
    .marca {
      color: #38bdf8;
      font-size: 1.25rem;
      font-weight: bold;
    }
    .topo-direita {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .badge-admin {
      background: #082f49;
      color: #38bdf8;
      border: 1px solid #0284c7;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: bold;
    }
    .badge-user {
      background: #1e293b;
      color: #cbd5e1;
      border: 1px solid #475569;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.82rem;
    }
    .btn, a.btn {
      background: #0284c7;
      color: #ffffff;
      text-decoration: none;
      border: none;
      padding: 8px 14px;
      border-radius: 6px;
      font-size: 0.88rem;
      cursor: pointer;
    }
    .btn:hover, a.btn:hover {
      background: #0ea5e9;
    }
    .btn-sair {
      background: #7f1d1d;
    }
    .btn-sair:hover {
      background: #991b1b;
    }
    .banner-trial {
      max-width: 1050px;
      margin: 18px auto 0 auto;
      padding: 12px 18px;
      background: #082f49;
      border: 1px solid #0284c7;
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }
    main {
      max-width: 1050px;
      margin: 22px auto;
      padding: 0 20px;
    }
    .card-player {
      background: #0f172a;
      border: 1px solid #1e293b;
      border-radius: 10px;
      padding: 22px;
      box-shadow: 0 0 24px rgba(0, 180, 255, 0.12);
    }
    .card-player h2 {
      margin: 0 0 16px 0;
      color: #38bdf8;
    }
    video {
      width: 100%;
      max-height: 480px;
      background: #000000;
      border-radius: 8px;
      border: 1px solid #1e293b;
    }
    .barra-admin-link {
      display: flex;
      gap: 10px;
      margin-top: 16px;
      flex-wrap: wrap;
    }
    .barra-admin-link input {
      flex: 1;
      min-width: 240px;
      padding: 10px 12px;
      border-radius: 6px;
      border: 1px solid #334155;
      background: #020617;
      color: #f8fafc;
    }
  </style>
</head>
<body>
  <% const isAdmin = utilizador && (utilizador.role || "").toLowerCase() === "administrador"; %>

  <header>
    <div class="marca">AlphaTV</div>
    <div class="topo-direita">
      <span>Olá, <strong><%= utilizador ? utilizador.nome : "Utilizador" %></strong></span>

      <% if (isAdmin) { %>
        <span class="badge-admin">Administrador</span>
        <a href="/admin" class="btn">Ir para Dashboard Admin</a>
      <% } else { %>
        <span class="badge-user">Utilizador</span>
      <% } %>

      <a href="/logout" class="btn btn-sair">Sair</a>
    </div>
  </header>

  <% if (!isAdmin && typeof acessoInfo !== "undefined" && acessoInfo && acessoInfo.emTeste) { %>
    <div class="banner-trial">
      <span>
        Período gratuito de 7 dias ativo: restam <strong><%= acessoInfo.diasRestantes %> dia(s)</strong> antes da subscrição.
      </span>
      <a href="/subscricao" class="btn">Ver Planos / Subscrever</a>
    </div>
  <% } %>

  <main>
    <div class="card-player">
      <h2>Conteúdo Interno</h2>
      <video id="videoPlayer" controls preload="metadata"></video>

      <% if (isAdmin) { %>
        <div class="barra-admin-link">
          <input
            type="text"
            id="inputLinkVideo"
            placeholder="Área Admin: cola aqui um link de vídeo (.mp4 ou .m3u8)..."
          />
          <button type="button" class="btn" onclick="reproduzirLink()">Reproduzir</button>
        </div>
      <% } %>
    </div>
  </main>

  <script>
    function reproduzirLink() {
      const input = document.getElementById("inputLinkVideo");
      const video = document.getElementById("videoPlayer");
      if (!input || !video) return;
      const url = input.value.trim();
      if (!url) return;
      video.src = url;
      video.play().catch(() => {});
    }
  </script>
</body>
</html>